+static BOOL is_url_file( const WCHAR *path )
+{
+    const WCHAR *ext = wcsrchr( path, '.' );
+    return ext && !wcsicmp( ext, L".url" );
+}
+
+static HICON extract_url_icon( const WCHAR *path )
+{
+    WCHAR tmp_path[MAX_PATH], icon_path[MAX_PATH];
+    SHFILEINFOW info;
+    HICON icon = NULL;
+    int index;
+
+    GetPrivateProfileStringW( L"InternetShortcut", L"IconFile", L"", tmp_path, MAX_PATH, path );
+    index = GetPrivateProfileIntW( L"InternetShortcut", L"IconIndex", 0, path );
+    ExpandEnvironmentStringsW( tmp_path, icon_path, MAX_PATH );
+    if (icon_path[0]) ExtractIconExW( icon_path, index, &icon, NULL, 1 );
+    if (!icon && SHGetFileInfoW( path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ))
+        icon = info.hIcon;
+    if (!icon) icon = CopyIcon( LoadIconW( 0, (const WCHAR *)IDI_APPLICATION ));
+    return icon;
+}
