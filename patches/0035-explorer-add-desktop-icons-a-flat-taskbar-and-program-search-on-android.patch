+static HICON get_window_icon( HWND hwnd )
+{
+    DWORD_PTR icon = 0;
+
+    if (!SendMessageTimeoutW( hwnd, WM_GETICON, ICON_SMALL2, 0, SMTO_ABORTIFHUNG, 100, &icon )) icon = 0;
+    if (!icon && !SendMessageTimeoutW( hwnd, WM_GETICON, ICON_BIG, 0, SMTO_ABORTIFHUNG, 100, &icon )) icon = 0;
+    if (!icon) icon = GetClassLongPtrW( hwnd, GCLP_HICONSM );
+    if (!icon) icon = GetClassLongPtrW( hwnd, GCLP_HICON );
+    return (HICON)icon;
+}
+
+/* WM_GETICON can't cross processes in Wine, so most windows need their program's icon */
+static HICON get_button_icon( struct taskbar_button *win )
+{
+    HICON icon = get_window_icon( win->hwnd );
+    WCHAR path[MAX_PATH];
+    DWORD pid, size = ARRAY_SIZE(path);
+    HANDLE process;
+
+    if (icon) return icon;
+    if (!win->exe_icon && GetWindowThreadProcessId( win->hwnd, &pid ) &&
+        (process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid )))
+    {
+        if (QueryFullProcessImageNameW( process, 0, path, &size ))
+            ExtractIconExW( path, 0, NULL, &win->exe_icon, 1 );
+        CloseHandle( process );
+        if (!win->exe_icon) win->exe_icon = CopyIcon( LoadIconW( 0, (const WCHAR *)IDI_APPLICATION ));
+    }
+    return win->exe_icon;
+}
