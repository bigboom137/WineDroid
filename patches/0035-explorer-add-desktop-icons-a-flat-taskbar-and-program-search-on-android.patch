+    if (paint_root)
+    {
+        HWND tray = FindWindowW( L"Shell_TrayWnd", NULL );
+        int height = GetSystemMetrics( SM_CYSCREEN );
+        unsigned int per_column;
+        RECT rect;
+
+        /* the work area isn't updated here when the Android window size arrives */
+        if (tray && IsWindowVisible( tray ) && GetWindowRect( tray, &rect ) && rect.top > 0)
+            height = min( height, rect.top );
+        per_column = max( 1, (height - 2 * launcher_margin) / launcher_size );
+        *col = index / per_column;
+        *row = index % per_column;
+    }
+    else
+    {
+        *row = index / launchers_per_row;
+        *col = index % launchers_per_row;
+    }
+}
