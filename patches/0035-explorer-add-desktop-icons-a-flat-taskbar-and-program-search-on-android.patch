+        fill_round_rect( dis->hDC, &rect, rect.bottom - rect.top,
+                         (dis->itemState & ODS_SELECTED) ? TASKBAR_PRESSED : TASKBAR_FIELD );
+        draw_search_glyph( dis->hDC, rect.left + unit * 3 / 4, (rect.bottom - unit * 3 / 4) / 2,
+                           unit * 3 / 4, TASKBAR_DIM );
+        rect.left += unit * 2;
+        SetTextColor( dis->hDC, TASKBAR_DIM );
+        DrawTextW( dis->hDC, L"Search", -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS );
+        return;
+    }
+
+    InflateRect( &rect, -2, -unit / 4 );
+    if (dis->itemState & ODS_SELECTED) fill_round_rect( dis->hDC, &rect, radius, TASKBAR_PRESSED );
+    else if (win->hwnd && win->active) fill_round_rect( dis->hDC, &rect, radius, TASKBAR_ACTIVE );
+
+    if (win->hwnd)
+    {
+        icon = get_button_icon( win );
+        if (!InternalGetWindowText( win->hwnd, title, ARRAY_SIZE(title) )) title[0] = 0;
+
+        /* a bar under every open window, a long accent one under the active one */
+        if (!IsIconic( win->hwnd ))
+        {
+            RECT bar = rect;
+            int width = win->active ? (rect.right - rect.left) / 3 : unit;
+
+            bar.left = (rect.left + rect.right - width) / 2;
+            bar.right = bar.left + width;
+            bar.top = rect.bottom - max( 2, unit / 6 );
+            fill_round_rect( dis->hDC, &bar, max( 2, unit / 6 ), win->active ? TASKBAR_ACCENT : TASKBAR_DIM );
+        }
+    }
+    else  /* start button: a grid of four tiles */
+    {
+        int tile = unit * 7 / 16, gap = max( 1, unit / 8 );
+        int x = rect.left + unit / 2, y = (rect.top + rect.bottom - unit) / 2;
+        RECT part;
+
+        icon = NULL;
+        lstrcpynW( title, start_label, ARRAY_SIZE(title) );
+        for (int i = 0; i < 4; i++)
+        {
+            SetRect( &part, x + (i % 2) * (tile + gap), y + (i / 2) * (tile + gap), 0, 0 );
+            part.right = part.left + tile;
+            part.bottom = part.top + tile;
+            fill_round_rect( dis->hDC, &part, max( 2, unit / 6 ), TASKBAR_ACCENT );
+        }
+    }
+
+    if (icon) DrawIconEx( dis->hDC, rect.left + unit / 2, (rect.top + rect.bottom - unit) / 2, icon,
+                          unit, unit, 0, 0, DI_NORMAL );
+    rect.left += unit * 2;
+    rect.right -= unit / 2;
+    SetTextColor( dis->hDC, (win->hwnd && !win->active) ? TASKBAR_DIM : TASKBAR_TEXT );
+    if (!win->hwnd) SetTextColor( dis->hDC, TASKBAR_TEXT );
+    DrawTextW( dis->hDC, title, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS );
+}
+
+static void update_clock( BOOL redraw )
+{
+    WCHAR time[32], date[32];
+    RECT rect;
+
+    if (!GetTimeFormatEx( NULL, TIME_NOSECONDS, NULL, NULL, time, ARRAY_SIZE(time) )) time[0] = 0;
+    if (!GetDateFormatEx( NULL, DATE_SHORTDATE, NULL, NULL, date, ARRAY_SIZE(date), NULL )) date[0] = 0;
+    if (!wcscmp( time, clock_time ) && !wcscmp( date, clock_date )) return;
+    lstrcpyW( clock_time, time );
+    lstrcpyW( clock_date, date );
+    if (!redraw) return;
+    SetRect( &rect, tray_width - clock_width, 0, tray_width, tray_height );
+    InvalidateRect( tray_window, &rect, TRUE );
+}
+
+static void paint_taskbar( HWND hwnd )
+{
+    PAINTSTRUCT ps;
+    RECT rect;
+    HDC hdc = BeginPaint( hwnd, &ps );
+    int unit = GetSystemMetrics( SM_CXSMICON );
+
+    GetClientRect( hwnd, &rect );
+    fill_color( hdc, &rect, TASKBAR_BG );
+    rect.bottom = rect.top + 1;
+    fill_color( hdc, &rect, TASKBAR_EDGE );
+
+    /* WineDroid's on-screen keyboard button is a transparent Android view over this key */
+    if (keyboard_width)
+    {
+        RECT key, dot;
+        int x, y, w = unit * 5 / 4, h = unit * 7 / 8, d = max( 1, unit / 8 );
+        HPEN pen = SelectObject( hdc, CreatePen( PS_SOLID, max( 1, unit / 12 ), TASKBAR_DIM ));
+        HBRUSH brush = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+
+        SetRect( &key, tray_width - keyboard_width, 0, tray_width, tray_height );
+        x = (key.left + key.right - w) / 2;
+        y = (key.top + key.bottom - h) / 2;
+        RoundRect( hdc, x, y, x + w, y + h, d * 2, d * 2 );
+        SelectObject( hdc, brush );
+        DeleteObject( SelectObject( hdc, pen ));
+        for (int row = 0; row < 2; row++)
+            for (int col = 0; col < 4; col++)
+            {
+                SetRect( &dot, x + w * (col + 1) / 5 - d / 2, y + h * (row + 1) / 4 - d / 2, 0, 0 );
+                dot.right = dot.left + d;
+                dot.bottom = dot.top + d;
+                fill_color( hdc, &dot, TASKBAR_DIM );
+            }
+        SetRect( &dot, x + w / 4, y + h * 3 / 4 - d / 2, x + w * 3 / 4, 0 );
+        dot.bottom = dot.top + d;
+        fill_color( hdc, &dot, TASKBAR_DIM );
+    }
+
+    SetRect( &rect, tray_width - clock_width, 0, tray_width - keyboard_width - unit / 2, tray_height );
+    SelectObject( hdc, taskbar_font );
+    SetBkMode( hdc, TRANSPARENT );
+    rect.bottom = tray_height / 2 + 1;
+    SetTextColor( hdc, TASKBAR_TEXT );
+    DrawTextW( hdc, clock_time, -1, &rect, DT_SINGLELINE | DT_BOTTOM | DT_CENTER | DT_NOPREFIX );
+    rect.top = rect.bottom;
+    rect.bottom = tray_height;
+    SetTextColor( hdc, TASKBAR_DIM );
+    DrawTextW( hdc, clock_date, -1, &rect, DT_SINGLELINE | DT_TOP | DT_CENTER | DT_NOPREFIX );
+    EndPaint( hwnd, &ps );
+}
