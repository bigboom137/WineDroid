+struct search_item
+{
+    WCHAR *name;
+    WCHAR *path;
+    HICON  icon;
+    BOOL   icon_loaded;
+};
+
+static struct search_item *items;
+static unsigned int nb_items, nb_items_allocated;
+
+static HWND search_window, search_edit, search_list;
+static WNDPROC orig_edit_proc, orig_list_proc;
+static HFONT search_font;
+static HBRUSH bg_brush, field_brush;
+static int unit;  /* small icon size, 16 at 96 dpi */
