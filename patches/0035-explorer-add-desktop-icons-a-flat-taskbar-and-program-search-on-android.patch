+/* programs that come with Wine, so that there is something to find in a new prefix */
+static const struct
+{
+    const WCHAR *name;
+    const WCHAR *exe;
+}
+builtin_programs[] =
+{
+    { L"Wine settings",       L"winecfg.exe" },
+    { L"Command prompt",      L"wineconsole.exe" },
+    { L"Notepad",             L"notepad.exe" },
+    { L"Registry editor",     L"regedit.exe" },
+    { L"Task manager",        L"taskmgr.exe" },
+    { L"File manager",        L"winefile.exe" },
+    { L"Wine explorer",       L"explorer.exe" },
+    { L"Control panel",       L"control.exe" },
+    { L"Uninstall programs",  L"uninstaller.exe" },
+};
+
+void draw_search_glyph( HDC hdc, int x, int y, int size, COLORREF color )
+{
+    int width = max( 1, size / 8 ), d = size * 5 / 8;
+    HPEN pen = SelectObject( hdc, CreatePen( PS_SOLID, width, color ));
+    HBRUSH brush = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+
+    Ellipse( hdc, x, y, x + d, y + d );
+    MoveToEx( hdc, x + d * 85 / 100, y + d * 85 / 100, NULL );
+    LineTo( hdc, x + size, y + size );
+    SelectObject( hdc, brush );
+    DeleteObject( SelectObject( hdc, pen ));
+}
+
+static void free_items(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < nb_items; i++)
+    {
+        free( items[i].name );
+        free( items[i].path );
+        if (items[i].icon) DestroyIcon( items[i].icon );
+    }
+    nb_items = 0;
+}
+
+static void add_item( const WCHAR *name, int name_len, const WCHAR *path )
+{
+    unsigned int i;
+
+    /* the same program is often in the start menu and on the desktop */
+    for (i = 0; i < nb_items; i++)
+        if (!wcsnicmp( items[i].name, name, name_len ) && !items[i].name[name_len]) return;
+
+    if (nb_items == nb_items_allocated)
+    {
+        unsigned int count = max( 32, nb_items_allocated * 2 );
+        struct search_item *tmp = realloc( items, count * sizeof(*tmp) );
+        if (!tmp) return;
+        items = tmp;
+        nb_items_allocated = count;
+    }
+    items[nb_items].name = malloc( (name_len + 1) * sizeof(WCHAR) );
+    items[nb_items].path = wcsdup( path );
+    if (!items[nb_items].name || !items[nb_items].path)
+    {
+        free( items[nb_items].name );
+        free( items[nb_items].path );
+        return;
+    }
+    memcpy( items[nb_items].name, name, name_len * sizeof(WCHAR) );
+    items[nb_items].name[name_len] = 0;
+    items[nb_items].icon = NULL;
+    items[nb_items].icon_loaded = FALSE;
+    nb_items++;
+}
+
+static void add_folder_items( const WCHAR *folder, int depth )
+{
+    WCHAR path[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    HANDLE handle;
+
+    if (depth > 4 || lstrlenW( folder ) + 3 > MAX_PATH) return;
+    swprintf( path, MAX_PATH, L"%s\\*", folder );
+    if ((handle = FindFirstFileW( path, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        const WCHAR *ext;
+        int len = lstrlenW( data.cFileName );
+
+        if (data.cFileName[0] == '.') continue;
+        if (lstrlenW( folder ) + len + 2 > MAX_PATH) continue;
+        swprintf( path, MAX_PATH, L"%s\\%s", folder, data.cFileName );
+        if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        {
+            add_folder_items( path, depth + 1 );
+            continue;
+        }
+        if (len < 5) continue;
+        ext = data.cFileName + len - 4;
+        if (wcsicmp( ext, L".lnk" ) && wcsicmp( ext, L".url" )) continue;
+        add_item( data.cFileName, len - 4, path );
+    }
+    while (FindNextFileW( handle, &data ));
+    FindClose( handle );
+}
+
+static void load_items(void)
+{
+    static const int folders[] = { CSIDL_PROGRAMS, CSIDL_COMMON_PROGRAMS,
+                                   CSIDL_DESKTOPDIRECTORY, CSIDL_COMMON_DESKTOPDIRECTORY };
+    WCHAR path[MAX_PATH];
+    unsigned int i;
+
+    free_items();
+    CoInitialize( NULL );  /* for the shell links, once per thread */
+    for (i = 0; i < ARRAY_SIZE(folders); i++)
+        if (SUCCEEDED( SHGetFolderPathW( NULL, folders[i], NULL, SHGFP_TYPE_CURRENT, path )))
+            add_folder_items( path, 0 );
+
+    for (i = 0; i < ARRAY_SIZE(builtin_programs); i++)
+        if (SearchPathW( NULL, builtin_programs[i].exe, NULL, MAX_PATH, path, NULL ))
+            add_item( builtin_programs[i].name, lstrlenW( builtin_programs[i].name ), path );
+}
+
+/* the icon a shortcut points to; SHGetFileInfo only gives Wine's generic link icon */
+static HICON get_shortcut_icon( const WCHAR *path )
+{
+    WCHAR tmp[MAX_PATH], file[MAX_PATH];
+    const WCHAR *ext = wcsrchr( path, '.' );
+    IShellLinkW *link;
+    IPersistFile *persist;
+    HICON icon = NULL;
+    int index = 0;
+
+    if (ext && !wcsicmp( ext, L".url" ))
+    {
+        GetPrivateProfileStringW( L"InternetShortcut", L"IconFile", L"", tmp, MAX_PATH, path );
+        index = GetPrivateProfileIntW( L"InternetShortcut", L"IconIndex", 0, path );
+        ExpandEnvironmentStringsW( tmp, file, MAX_PATH );
+        if (file[0]) ExtractIconExW( file, index, &icon, NULL, 1 );
+        return icon;
+    }
+    if (!ext || wcsicmp( ext, L".lnk" ))
+    {
+        ExtractIconExW( path, 0, &icon, NULL, 1 );
+        return icon;
+    }
+
+    if (FAILED( CoCreateInstance( &CLSID_ShellLink, NULL, CLSCTX_INPROC_SERVER, &IID_IShellLinkW, (void **)&link )))
+        return NULL;
+    if (SUCCEEDED( IShellLinkW_QueryInterface( link, &IID_IPersistFile, (void **)&persist )))
+    {
+        if (SUCCEEDED( IPersistFile_Load( persist, path, 0 )))
+        {
+            tmp[0] = 0;
+            IShellLinkW_GetIconLocation( link, tmp, MAX_PATH, &index );
+            ExpandEnvironmentStringsW( tmp, file, MAX_PATH );
+            if (file[0]) ExtractIconExW( file, index, &icon, NULL, 1 );
+            if (!icon)
+            {
+                tmp[0] = 0;
+                IShellLinkW_GetPath( link, tmp, MAX_PATH, NULL, SLGP_RAWPATH );
+                ExpandEnvironmentStringsW( tmp, file, MAX_PATH );
+                if (file[0]) ExtractIconExW( file, 0, &icon, NULL, 1 );
+            }
+        }
+        IPersistFile_Release( persist );
+    }
+    IShellLinkW_Release( link );
+    return icon;
+}
+
+static HICON get_item_icon( struct search_item *item )
+{
+    SHFILEINFOW info;
+
+    if (!item->icon_loaded)
+    {
+        item->icon_loaded = TRUE;
+        item->icon = get_shortcut_icon( item->path );
+        if (!item->icon && SHGetFileInfoW( item->path, 0, &info, sizeof(info), SHGFI_ICON | SHGFI_LARGEICON ))
+            item->icon = info.hIcon;
+    }
+    return item->icon;
+}
+
+/* 0 for a match at the start of the name, 1 at the start of a word, 2 anywhere, -1 for none */
+static int match_rank( const WCHAR *name, const WCHAR *query, int query_len )
+{
+    const WCHAR *p;
+    int rank = -1;
+
+    if (!query_len) return 0;
+    for (p = name; *p; p++)
+    {
+        if (wcsnicmp( p, query, query_len )) continue;
+        if (p == name) return 0;
+        if (!iswalnum( p[-1] )) rank = 1;
+        else if (rank == -1) rank = 2;
+    }
+    return rank;
+}
+
+static const WCHAR *sort_query;
+static int sort_query_len;
+
+static int __cdecl compare_items( const void *a, const void *b )
+{
+    const struct search_item *item1 = &items[*(const unsigned int *)a];
+    const struct search_item *item2 = &items[*(const unsigned int *)b];
+    int rank1 = match_rank( item1->name, sort_query, sort_query_len );
+    int rank2 = match_rank( item2->name, sort_query, sort_query_len );
+
+    if (rank1 != rank2) return rank1 - rank2;
+    return lstrcmpiW( item1->name, item2->name );
+}
+
+static void update_results(void)
+{
+    WCHAR query[MAX_PATH];
+    unsigned int i, count = 0, *order;
+    int len;
+
+    len = GetWindowTextW( search_edit, query, ARRAY_SIZE(query) );
+    while (len && query[len - 1] == ' ') query[--len] = 0;
+
+    SendMessageW( search_list, WM_SETREDRAW, FALSE, 0 );
+    SendMessageW( search_list, LB_RESETCONTENT, 0, 0 );
+    if ((order = malloc( max( 1, nb_items ) * sizeof(*order) )))
+    {
+        for (i = 0; i < nb_items; i++)
+            if (match_rank( items[i].name, query, len ) >= 0) order[count++] = i;
+        sort_query = query;
+        sort_query_len = len;
+        qsort( order, count, sizeof(*order), compare_items );
+        for (i = 0; i < count; i++) SendMessageW( search_list, LB_ADDSTRING, 0, order[i] );
+        free( order );
+    }
+    if (len) SendMessageW( search_list, LB_ADDSTRING, 0, RUN_ITEM );
+    SendMessageW( search_list, LB_SETCURSEL, 0, 0 );
+    SendMessageW( search_list, WM_SETREDRAW, TRUE, 0 );
+    InvalidateRect( search_list, NULL, TRUE );
+}
+
+static void close_search(void)
+{
+    if (search_window) DestroyWindow( search_window );
+}
+
+static void run_command( WCHAR *command )
+{
+    WCHAR *args = NULL, *p;
+
+    if ((INT_PTR)ShellExecuteW( NULL, NULL, command, NULL, NULL, SW_SHOWNORMAL ) > 32) return;
+
+    /* split off the arguments, allowing a quoted program name */
+    if (command[0] == '"' && (p = wcschr( command + 1, '"' )))
+    {
+        *p = 0;
+        args = p + 1;
+        command++;
+    }
+    else if ((p = wcschr( command, ' ' )))
+    {
+        *p = 0;
+        args = p + 1;
+    }
+    if (args) while (*args == ' ') args++;
+    if ((INT_PTR)ShellExecuteW( NULL, NULL, command, args, NULL, SW_SHOWNORMAL ) <= 32)
+    {
+        WCHAR message[MAX_PATH + 64];
+        swprintf( message, ARRAY_SIZE(message), L"Could not find \"%s\".", command );
+        MessageBoxW( NULL, message, L"Search", MB_OK | MB_ICONERROR );
+    }
+}
+
+static void launch_item( int index )
+{
+    WCHAR command[MAX_PATH];
+    LPARAM data;
+
+    if (index < 0) index = 0;
+    data = SendMessageW( search_list, LB_GETITEMDATA, index, 0 );
+    if (data == LB_ERR) return;
+    if (data == RUN_ITEM)
+    {
+        GetWindowTextW( search_edit, command, ARRAY_SIZE(command) );
+        close_search();
+        run_command( command );
+        return;
+    }
+    lstrcpynW( command, items[data].path, ARRAY_SIZE(command) );
+    close_search();
+    ShellExecuteW( NULL, NULL, command, NULL, NULL, SW_SHOWNORMAL );
+}
+
+static LRESULT WINAPI edit_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    switch (msg)
+    {
+    case WM_KEYDOWN:
+    {
+        int sel = SendMessageW( search_list, LB_GETCURSEL, 0, 0 );
+        int count = SendMessageW( search_list, LB_GETCOUNT, 0, 0 );
+
+        switch (wparam)
+        {
+        case VK_DOWN:
+            if (sel + 1 < count) SendMessageW( search_list, LB_SETCURSEL, sel + 1, 0 );
+            return 0;
+        case VK_UP:
+            if (sel > 0) SendMessageW( search_list, LB_SETCURSEL, sel - 1, 0 );
+            return 0;
+        case VK_NEXT:
+            SendMessageW( search_list, LB_SETCURSEL, min( count - 1, sel + 8 ), 0 );
+            return 0;
+        case VK_PRIOR:
+            SendMessageW( search_list, LB_SETCURSEL, max( 0, sel - 8 ), 0 );
+            return 0;
+        case VK_RETURN:
+            launch_item( sel );
+            return 0;
+        case VK_ESCAPE:
+            close_search();
+            return 0;
+        }
+        break;
+    }
+    case WM_CHAR:
+        if (wparam == '\r' || wparam == 27) return 0;  /* no beep */
+        break;
+    case WM_PAINT:
+    {
+        LRESULT ret = CallWindowProcW( orig_edit_proc, hwnd, msg, wparam, lparam );
+
+        if (!GetWindowTextLengthW( hwnd ))
+        {
+            HDC hdc = GetDC( hwnd );
+            RECT rect;
+
+            GetClientRect( hwnd, &rect );
+            rect.left += 2;
+            SelectObject( hdc, search_font );
+            SetBkMode( hdc, TRANSPARENT );
+            SetTextColor( hdc, SEARCH_DIM );
+            DrawTextW( hdc, L"Type to search programs", -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX );
+            ReleaseDC( hwnd, hdc );
+        }
+        return ret;
+    }
+    }
+    return CallWindowProcW( orig_edit_proc, hwnd, msg, wparam, lparam );
+}
+
+static int list_item_from_point( HWND hwnd, LPARAM lparam )
+{
+    DWORD ret = SendMessageW( hwnd, LB_ITEMFROMPOINT, 0, lparam );
+
+    if (HIWORD(ret)) return -1;  /* outside of the items */
+    return LOWORD(ret);
+}
+
+/* the edit control keeps the focus, the list only shows the results */
+static LRESULT WINAPI list_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    int index;
+
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        if ((index = list_item_from_point( hwnd, lparam )) >= 0 &&
+            index != SendMessageW( hwnd, LB_GETCURSEL, 0, 0 ))
+            SendMessageW( hwnd, LB_SETCURSEL, index, 0 );
+        return 0;
+    case WM_LBUTTONDOWN:
+    case WM_LBUTTONDBLCLK:
+        if ((index = list_item_from_point( hwnd, lparam )) >= 0)
+            SendMessageW( hwnd, LB_SETCURSEL, index, 0 );
+        return 0;
+    case WM_LBUTTONUP:
+        if ((index = list_item_from_point( hwnd, lparam )) >= 0) launch_item( index );
+        return 0;
+    case WM_SETFOCUS:
+        SetFocus( search_edit );
+        return 0;
+    }
+    return CallWindowProcW( orig_list_proc, hwnd, msg, wparam, lparam );
+}
+
+static void get_field_rect( HWND hwnd, RECT *rect )
+{
+    TEXTMETRICW tm;
+    HDC hdc = GetDC( hwnd );
+
+    SelectObject( hdc, search_font );
+    GetTextMetricsW( hdc, &tm );
+    ReleaseDC( hwnd, hdc );
+    GetClientRect( hwnd, rect );
+    InflateRect( rect, -unit, -unit );
+    rect->bottom = rect->top + tm.tmHeight + unit;
+}
+
+static void layout_search( HWND hwnd )
+{
+    RECT client, field;
+    int glyph = unit;
+
+    GetClientRect( hwnd, &client );
+    get_field_rect( hwnd, &field );
+    SetWindowPos( search_edit, 0, field.left + glyph * 2, field.top + unit / 3,
+                  field.right - field.left - glyph * 2 - unit / 2, field.bottom - field.top - unit * 2 / 3,
+                  SWP_NOZORDER | SWP_NOACTIVATE );
+    SetWindowPos( search_list, 0, unit / 2, field.bottom + unit / 2,
+                  client.right - unit, client.bottom - field.bottom - unit,
+                  SWP_NOZORDER | SWP_NOACTIVATE );
+}
+
+static void paint_search( HWND hwnd )
+{
+    PAINTSTRUCT ps;
+    RECT client, field;
+    HDC hdc = BeginPaint( hwnd, &ps );
+    HPEN pen;
+    HBRUSH brush;
+
+    GetClientRect( hwnd, &client );
+    FillRect( hdc, &client, bg_brush );
+    pen = SelectObject( hdc, CreatePen( PS_SOLID, 1, SEARCH_BORDER ));
+    brush = SelectObject( hdc, GetStockObject( NULL_BRUSH ));
+    Rectangle( hdc, client.left, client.top, client.right, client.bottom );
+
+    get_field_rect( hwnd, &field );
+    SelectObject( hdc, field_brush );
+    RoundRect( hdc, field.left, field.top, field.right, field.bottom, unit / 2, unit / 2 );
+    SelectObject( hdc, brush );
+    DeleteObject( SelectObject( hdc, pen ));
+
+    /* accent line under the search field, like the active taskbar button */
+    SetRect( &client, field.left + unit / 4, field.bottom - max( 2, unit / 8 ), field.right - unit / 4, field.bottom );
+    brush = CreateSolidBrush( SEARCH_ACCENT );
+    FillRect( hdc, &client, brush );
+    DeleteObject( brush );
+
+    draw_search_glyph( hdc, field.left + unit / 2, (field.top + field.bottom - unit * 3 / 4) / 2,
+                       unit * 3 / 4, SEARCH_DIM );
+    EndPaint( hwnd, &ps );
+}
+
+static void draw_item( const DRAWITEMSTRUCT *dis )
+{
+    WCHAR text[MAX_PATH + 16];
+    RECT rect = dis->rcItem;
+    HICON icon = NULL;
+    int icon_size = unit * 3 / 2;
+    HBRUSH brush;
+    HPEN pen;
+
+    FillRect( dis->hDC, &rect, bg_brush );
+    if (dis->itemID == (UINT)-1) return;
+
+    if (dis->itemState & ODS_SELECTED)
+    {
+        brush = SelectObject( dis->hDC, CreateSolidBrush( SEARCH_SELECTED ));
+        pen = SelectObject( dis->hDC, GetStockObject( NULL_PEN ));
+        RoundRect( dis->hDC, rect.left, rect.top + 1, rect.right + 1, rect.bottom, unit / 2, unit / 2 );
+        DeleteObject( SelectObject( dis->hDC, brush ));
+        SelectObject( dis->hDC, pen );
+    }
+
+    if (dis->itemData == RUN_ITEM)
+    {
+        WCHAR query[MAX_PATH];
+
+        GetWindowTextW( search_edit, query, ARRAY_SIZE(query) );
+        swprintf( text, ARRAY_SIZE(text), L"Run \"%s\"", query );
+        draw_search_glyph( dis->hDC, rect.left + unit / 2 + (icon_size - unit) / 2,
+                           (rect.top + rect.bottom - unit) / 2, unit, SEARCH_DIM );
+    }
+    else
+    {
+        lstrcpynW( text, items[dis->itemData].name, ARRAY_SIZE(text) );
+        icon = get_item_icon( &items[dis->itemData] );
+    }
+
+    if (icon) DrawIconEx( dis->hDC, rect.left + unit / 2, (rect.top + rect.bottom - icon_size) / 2,
+                          icon, icon_size, icon_size, 0, 0, DI_NORMAL );
+
+    rect.left += unit + icon_size;
+    rect.right -= unit / 2;
+    SelectObject( dis->hDC, search_font );
+    SetBkMode( dis->hDC, TRANSPARENT );
+    SetTextColor( dis->hDC, dis->itemData == RUN_ITEM ? SEARCH_DIM : SEARCH_TEXT );
+    DrawTextW( dis->hDC, text, -1, &rect, DT_SINGLELINE | DT_VCENTER | DT_NOPREFIX | DT_END_ELLIPSIS );
+}
+
+static LRESULT WINAPI search_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    switch (msg)
+    {
+    case WM_CREATE:
+        search_edit = CreateWindowExW( 0, L"Edit", NULL, WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL,
+                                       0, 0, 0, 0, hwnd, (HMENU)ID_EDIT, 0, NULL );
+        search_list = CreateWindowExW( 0, L"ListBox", NULL,
+                                       WS_CHILD | WS_VISIBLE | WS_VSCROLL | LBS_OWNERDRAWFIXED |
+                                       LBS_NOINTEGRALHEIGHT | LBS_NOTIFY,
+                                       0, 0, 0, 0, hwnd, (HMENU)ID_LIST, 0, NULL );
+        SendMessageW( search_edit, WM_SETFONT, (WPARAM)search_font, FALSE );
+        orig_edit_proc = (WNDPROC)SetWindowLongPtrW( search_edit, GWLP_WNDPROC, (LONG_PTR)edit_proc );
+        orig_list_proc = (WNDPROC)SetWindowLongPtrW( search_list, GWLP_WNDPROC, (LONG_PTR)list_proc );
+        layout_search( hwnd );
+        update_results();
+        return 0;
+
+    case WM_SIZE:
+        layout_search( hwnd );
+        return 0;
+
+    case WM_PAINT:
+        paint_search( hwnd );
+        return 0;
+
+    case WM_ERASEBKGND:
+        return 1;
+
+    case WM_MEASUREITEM:
+        ((MEASUREITEMSTRUCT *)lparam)->itemHeight = unit * 5 / 2;
+        return TRUE;
+
+    case WM_DRAWITEM:
+        draw_item( (const DRAWITEMSTRUCT *)lparam );
+        return TRUE;
+
+    case WM_CTLCOLOREDIT:
+        SetTextColor( (HDC)wparam, SEARCH_TEXT );
+        SetBkColor( (HDC)wparam, SEARCH_FIELD );
+        return (LRESULT)field_brush;
+
+    case WM_CTLCOLORLISTBOX:
+        return (LRESULT)bg_brush;
+
+    case WM_COMMAND:
+        if (LOWORD(wparam) == ID_EDIT && HIWORD(wparam) == EN_CHANGE) update_results();
+        return 0;
+
+    case WM_ACTIVATE:
+        if (LOWORD(wparam) == WA_INACTIVE) PostMessageW( hwnd, WM_CLOSE, 0, 0 );
+        else SetFocus( search_edit );
+        return 0;
+
+    case WM_CLOSE:
+        DestroyWindow( hwnd );
+        return 0;
+
+    case WM_DESTROY:
+        search_window = search_edit = search_list = NULL;
+        free_items();
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+BOOL is_search_open(void)
+{
+    return search_window != NULL;
+}
+
+/* show the search popup above the taskbar button, or close it if it's open */
+void toggle_search( HWND button )
+{
+    static BOOL registered;
+    NONCLIENTMETRICSW ncm = {sizeof(ncm)};
+    RECT anchor, work;
+    int width, height, x, y;
+
+    if (search_window)
+    {
+        close_search();
+        return;
+    }
+
+    unit = GetSystemMetrics( SM_CYSMICON );
+    if (!registered)
+    {
+        WNDCLASSW class = {0};
+
+        class.lpfnWndProc = search_wndproc;
+        class.hCursor = LoadCursorW( 0, (const WCHAR *)IDC_ARROW );
+        class.lpszClassName = L"__wine_taskbar_search";
+        if (!RegisterClassW( &class )) return;
+        bg_brush = CreateSolidBrush( SEARCH_BG );
+        field_brush = CreateSolidBrush( SEARCH_FIELD );
+        SystemParametersInfoW( SPI_GETNONCLIENTMETRICS, sizeof(ncm), &ncm, 0 );
+        ncm.lfMessageFont.lfHeight = ncm.lfMessageFont.lfHeight * 6 / 5;
+        search_font = CreateFontIndirectW( &ncm.lfMessageFont );
+        registered = TRUE;
+    }
+
+    load_items();
+
+    GetWindowRect( button, &anchor );
+    SystemParametersInfoW( SPI_GETWORKAREA, 0, &work, 0 );
+    width = min( unit * 28, work.right - work.left );
+    height = min( unit * 30, anchor.top - work.top - unit / 2 );
+    x = max( work.left, min( anchor.left, work.right - width ));
+    y = anchor.top - unit / 4 - height;
+
+    search_window = CreateWindowExW( WS_EX_TOOLWINDOW | WS_EX_TOPMOST, L"__wine_taskbar_search", L"Search",
+                                     WS_POPUP | WS_CLIPCHILDREN, x, y, width, height, 0, 0, 0, NULL );
+    if (!search_window) return;
+    ShowWindow( search_window, SW_SHOW );
+    SetForegroundWindow( search_window );
+    SetFocus( search_edit );
+}
