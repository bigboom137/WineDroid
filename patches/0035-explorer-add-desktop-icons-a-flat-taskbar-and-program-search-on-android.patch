+#define SEARCH_BORDER   RGB(62, 66, 78)
+#define SEARCH_FIELD    RGB(47, 50, 60)
+#define SEARCH_ACCENT   RGB(76, 154, 255)
+#define SEARCH_TEXT     RGB(236, 238, 243)
+#define SEARCH_DIM      RGB(150, 155, 168)
+#define SEARCH_SELECTED RGB(56, 64, 84)
