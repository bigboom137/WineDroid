Subject: [PATCH] wineaaudio.drv: Keep the AAudio stream filled independently of padding.

The padding included what was queued in AAudio, so programs that keep a
small buffer (BASS with its 10 ms "lower latency" setting) never queued
a whole burst, and Android's mixer ran dry on every one: crackling audio
in Estella. Count frames as played once they are in the AAudio stream,
keep that filled up to its buffer size on its own, and subtract what it
holds from the position (and add it to the latency) so audio sync stays
right.
---
--- a/dlls/wineaaudio.drv/aaudio.c
+++ b/dlls/wineaaudio.drv/aaudio.c
@@ -43,7 +43,11 @@
 #include "../mmdevapi/unixlib.h"
 
 /* Render only: the streams keep the OSS driver's local ring buffer, which the
- * timer loop feeds to an AAudio stream in blocking-write mode, without blocking. */
+ * timer loop feeds to an AAudio stream in blocking-write mode, without blocking.
+ * Frames count as played (no longer padding) once they are in the AAudio
+ * stream, which the timer loop keeps a few bursts ahead on its own: programs
+ * asking for small buffers (BASS: 10 ms) would otherwise never queue a whole
+ * burst, and Android's mixer would run dry on every one. */
 struct aaudio_stream
 {
     WAVEFORMATEX *fmt;
@@ -58,7 +62,7 @@
 
     BOOL playing, mute, please_quit;
     UINT64 written_frames, last_pos_frames;
-    UINT32 period_frames, bufsize_frames, held_frames, tmp_buffer_frames, in_dev_frames;
+    UINT32 period_frames, bufsize_frames, held_frames, tmp_buffer_frames;
     UINT32 lcl_offs_frames; /* offs into local_buffer where valid data starts */
     REFERENCE_TIME period;
 
@@ -336,7 +340,7 @@
         return NULL;
     }
 
-    /* room for the three periods the timer loop keeps queued */
+    /* what the timer loop keeps queued, see aaudio_write_data() */
     burst = AAudioStream_getFramesPerBurst(aa);
     capacity = AAudioStream_getBufferCapacityInFrames(aa);
     AAudioStream_setBufferSizeInFrames(aa, min(capacity, max(burst * 2, (int32_t)period_frames * 3)));
@@ -512,7 +516,6 @@
     stream->last_pos_frames = 0;
     stream->held_frames = 0;
     stream->lcl_offs_frames = 0;
-    stream->in_dev_frames = 0;
 
     return aaudio_unlock_result(stream, &params->result, S_OK);
 }
@@ -559,7 +562,6 @@
     if(!(aa = open_aaudio_stream(stream->fmt, stream->aa_format, stream->period_frames))) return;
     AAudioStream_close(stream->aa);
     stream->aa = aa;
-    stream->in_dev_frames = 0;
     stream->silence_end = 0;
     if(stream->playing){
         write_start_silence(stream);
@@ -588,60 +590,26 @@
 
 static void aaudio_write_data(struct aaudio_stream *stream)
 {
-    UINT32 written_frames, in_dev_frames, write_limit, max_period, write_offs_frames, new_frames;
-    SIZE_T to_write_frames, advanced;
+    UINT32 queued, target, to_write, chunk, written;
 
-    max_period = max((UINT32)AAudioStream_getFramesPerBurst(stream->aa), stream->period_frames);
-
-    in_dev_frames = get_queued_frames(stream);
-    TRACE("state %d written %lld read %lld queued %u held %u in_dev %u\n", AAudioStream_getState(stream->aa),
+    target = AAudioStream_getBufferSizeInFrames(stream->aa);
+    queued = get_queued_frames(stream);
+    TRACE("state %d written %lld read %lld queued %u held %u\n", AAudioStream_getState(stream->aa),
           (long long)AAudioStream_getFramesWritten(stream->aa), (long long)AAudioStream_getFramesRead(stream->aa),
-          in_dev_frames, stream->held_frames, stream->in_dev_frames);
-    if(in_dev_frames > stream->in_dev_frames)
-        in_dev_frames = stream->in_dev_frames;
-
-    write_limit = 0;
-    while(write_limit + in_dev_frames < max_period * 3)
-        write_limit += max_period;
-    if(write_limit == 0)
-        return;
-
-    /*        vvvvvv - in_dev_frames
-     * [--xxxxxxxxxx]
-     *       [xxxxxxxxxx--]
-     *        ^^^^^^^^^^ - held_frames
-     *        ^ - lcl_offs_frames
-     */
-    advanced = stream->in_dev_frames - in_dev_frames;
-    if(advanced > stream->held_frames)
-        advanced = stream->held_frames;
-    stream->lcl_offs_frames += advanced;
-    stream->lcl_offs_frames %= stream->bufsize_frames;
-    stream->held_frames -= advanced;
-    stream->in_dev_frames = in_dev_frames;
-
-    if(stream->held_frames == stream->in_dev_frames)
+          queued, stream->held_frames);
+    if(queued >= target)
         return;
 
-    write_offs_frames = (stream->lcl_offs_frames + stream->in_dev_frames) % stream->bufsize_frames;
-    new_frames = stream->held_frames - stream->in_dev_frames;
-
-    if(write_offs_frames + new_frames > stream->bufsize_frames)
-        to_write_frames = stream->bufsize_frames - write_offs_frames;
-    else
-        to_write_frames = new_frames;
-    to_write_frames = min(to_write_frames, write_limit);
-
-    written_frames = write_frames(stream, stream->local_buffer + write_offs_frames * stream->fmt->nBlockAlign,
-                                  to_write_frames);
-    stream->in_dev_frames += written_frames;
-    if(written_frames < to_write_frames)
-        return;  /* AAudio buffer full */
-
-    if(new_frames > written_frames && written_frames < write_limit){
-        /* wrapped and have some data back at the start to write */
-        to_write_frames = min(write_limit - written_frames, new_frames - written_frames);
-        stream->in_dev_frames += write_frames(stream, stream->local_buffer, to_write_frames);
+    to_write = min(target - queued, stream->held_frames);
+    while(to_write){
+        chunk = min(to_write, stream->bufsize_frames - stream->lcl_offs_frames);
+        written = write_frames(stream, stream->local_buffer + stream->lcl_offs_frames * stream->fmt->nBlockAlign,
+                               chunk);
+        stream->lcl_offs_frames = (stream->lcl_offs_frames + written) % stream->bufsize_frames;
+        stream->held_frames -= written;
+        to_write -= written;
+        if(written < chunk)
+            break;  /* AAudio buffer full */
     }
 }
 
@@ -876,9 +844,11 @@
 
     aaudio_lock(stream);
 
-    /* pretend we process audio in Period chunks, so max latency includes
-     * the period time.  Some native machines add .6666ms in shared mode. */
+    /* the period, plus what the timer loop keeps queued in AAudio */
     *params->latency = stream->period + 6666;
+    if(stream->aa)
+        *params->latency += (REFERENCE_TIME)AAudioStream_getBufferSizeInFrames(stream->aa) * 10000000
+                            / stream->fmt->nSamplesPerSec;
 
     return aaudio_unlock_result(stream, &params->result, S_OK);
 }
@@ -938,7 +908,10 @@
 
     aaudio_lock(stream);
 
+    /* what AAudio hasn't played yet isn't padding, but isn't played either */
     *pos = stream->written_frames - stream->held_frames;
+    if(stream->aa)
+        *pos -= min(*pos, (UINT64)get_queued_frames(stream));
     if(*pos < stream->last_pos_frames)
         *pos = stream->last_pos_frames;
     stream->last_pos_frames = *pos;
