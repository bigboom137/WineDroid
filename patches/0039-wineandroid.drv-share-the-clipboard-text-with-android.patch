+/* text in the Android clipboard (UTF-16), for both directions */
+struct ioctl_android_clipboard
+{
+    struct ioctl_header hdr;
+    UINT                size;     /* in bytes, without a terminating null */
+    WCHAR               text[1];
+};
+
+#define MAX_CLIPBOARD_SIZE (16 * 1024 * 1024)
+
 static struct native_win_data *get_ioctl_native_win_data( const struct ioctl_header *hdr )
 {
     return get_native_win_data( LongToHandle(hdr->hwnd), hdr->opengl );
@@ -1150,6 +1162,62 @@
     return STATUS_SUCCESS;
 }
 
+/* the size is always returned; the text only if it fits in the output buffer */
+static NTSTATUS getClipboard_ioctl( void *data, DWORD in_size, DWORD out_size, ULONG_PTR *ret_size )
+{
+    static jmethodID method;
+    struct ioctl_android_clipboard *res = data;
+    jobject object;
+    jstring str;
+    jsize len = 0;
+
+    if (out_size < offsetof( struct ioctl_android_clipboard, text )) return STATUS_BUFFER_TOO_SMALL;
+
+    if (!(object = load_java_method( &method, "getClipboardText", "()Ljava/lang/String;" )))
+        return STATUS_NOT_SUPPORTED;
+
+    wrap_java_call();
+    str = (*jni_env)->CallObjectMethod( jni_env, object, method );
+    if (str) len = (*jni_env)->GetStringLength( jni_env, str );
+    if (len > MAX_CLIPBOARD_SIZE / sizeof(WCHAR)) len = MAX_CLIPBOARD_SIZE / sizeof(WCHAR);
+    res->size = len * sizeof(WCHAR);
+    *ret_size = offsetof( struct ioctl_android_clipboard, text );
+    if (out_size >= offsetof( struct ioctl_android_clipboard, text ) + res->size)
+    {
+        if (len) (*jni_env)->GetStringRegion( jni_env, str, 0, len, (jchar *)res->text );
+        *ret_size += res->size;
+    }
+    if (str) (*jni_env)->DeleteLocalRef( jni_env, str );
+    unwrap_java_call();
+
+    TRACE( "%u bytes\n", res->size );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS setClipboard_ioctl( void *data, DWORD in_size, DWORD out_size, ULONG_PTR *ret_size )
+{
+    static jmethodID method;
+    struct ioctl_android_clipboard *res = data;
+    jobject object;
+    jstring str;
+
+    if (in_size < offsetof( struct ioctl_android_clipboard, text )) return STATUS_INVALID_PARAMETER;
+    if (res->size > in_size - offsetof( struct ioctl_android_clipboard, text ) || res->size % sizeof(WCHAR))
+        return STATUS_INVALID_PARAMETER;
+
+    TRACE( "%u bytes\n", res->size );
+
+    if (!(object = load_java_method( &method, "setClipboardText", "(Ljava/lang/String;)V" )))
+        return STATUS_NOT_SUPPORTED;
+
+    wrap_java_call();
+    str = (*jni_env)->NewString( jni_env, (const jchar *)res->text, res->size / sizeof(WCHAR) );
+    (*jni_env)->CallVoidMethod( jni_env, object, method, str );
+    (*jni_env)->DeleteLocalRef( jni_env, str );
+    unwrap_java_call();
+    return STATUS_SUCCESS;
+}
+
 typedef NTSTATUS (*ioctl_func)( void *in, DWORD in_size, DWORD out_size, ULONG_PTR *ret_size );
 static const ioctl_func ioctl_funcs[] =
 {
@@ -1165,6 +1233,8 @@
     setSwapInterval_ioctl,      /* IOCTL_SET_SWAP_INT */
     setCapture_ioctl,           /* IOCTL_SET_CAPTURE */
     setCursor_ioctl,            /* IOCTL_SET_CURSOR */
+    getClipboard_ioctl,         /* IOCTL_GET_CLIPBOARD */
+    setClipboard_ioctl,         /* IOCTL_SET_CLIPBOARD */
 };
 
 /* drop the Java views of windows that no longer exist; a process that exits
@@ -1831,3 +1901,65 @@
     free( req );
     return ret;
 }
+
+/* the caller frees *text; *len is in characters, the text is null-terminated */
+int ioctl_get_clipboard( WCHAR **text, UINT *len )
+{
+    struct ioctl_android_clipboard *req;
+    DWORD size = offsetof( struct ioctl_android_clipboard, text[16384] );
+    int i, ret = -ENOMEM;
+
+    for (i = 0; i < 3; i++)
+    {
+        /* output buffers have to be Wine-managed memory, not the Unix heap */
+        SIZE_T alloc_size = size;
+        DWORD out_size = size;
+
+        req = NULL;
+        if (NtAllocateVirtualMemory( GetCurrentProcess(), (void **)&req, 0, &alloc_size,
+                                     MEM_COMMIT, PAGE_READWRITE ))
+            return -ENOMEM;
+        req->hdr.hwnd = 0;
+        req->hdr.opengl = FALSE;
+        req->size = 0;
+        ret = android_ioctl( IOCTL_GET_CLIPBOARD, req, sizeof(*req), req, &out_size );
+        if (!ret && out_size == offsetof( struct ioctl_android_clipboard, text ) + req->size)
+        {
+            *len = req->size / sizeof(WCHAR);
+            if ((*text = malloc( req->size + sizeof(WCHAR) )))
+            {
+                memcpy( *text, req->text, req->size );
+                (*text)[*len] = 0;
+            }
+            else ret = -ENOMEM;
+        }
+        else if (!ret)
+        {
+            /* the text didn't fit, or changed in between */
+            size = offsetof( struct ioctl_android_clipboard, text ) + req->size;
+            ret = -EAGAIN;
+        }
+        alloc_size = 0;
+        NtFreeVirtualMemory( GetCurrentProcess(), (void **)&req, &alloc_size, MEM_RELEASE );
+        if (ret != -EAGAIN) break;
+    }
+    return ret;
+}
+
+int ioctl_set_clipboard( const WCHAR *text, UINT len )
+{
+    struct ioctl_android_clipboard *req;
+    unsigned int size;
+    int ret;
+
+    if (len > MAX_CLIPBOARD_SIZE / sizeof(WCHAR)) len = MAX_CLIPBOARD_SIZE / sizeof(WCHAR);
+    size = offsetof( struct ioctl_android_clipboard, text[len] );
+    if (!(req = malloc( size ))) return -ENOMEM;
+    req->hdr.hwnd = 0;
+    req->hdr.opengl = FALSE;
+    req->size = len * sizeof(WCHAR);
+    memcpy( req->text, text, req->size );
+    ret = android_ioctl( IOCTL_SET_CLIPBOARD, req, size, NULL, NULL );
+    free( req );
+    return ret;
+}
