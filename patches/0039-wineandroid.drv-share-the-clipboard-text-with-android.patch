+WINE_DEFAULT_DEBUG_CHANNEL(clipboard);
+
+/* Text is shared both ways through explorer's clipboard manager window,
+ * which runs in the desktop process like the Java side:
+ * - Java reports Android clipboard changes (and the window getting focus,
+ *   since Android only lets the focused app read the clipboard); the window
+ *   then takes the text and becomes the Wine clipboard owner.
+ * - Wine clipboard changes by programs reach the window as WM_CLIPBOARDUPDATE;
+ *   it sends their CF_UNICODETEXT to Java.
+ * The text last exchanged either way is kept to stop it from bouncing back. */
+
+static HWND clipboard_hwnd;
+static BOOL is_clipboard_owner;
+static WCHAR *last_text;
+static UINT last_len;
+
+static BOOL is_last_text( const WCHAR *text, UINT len )
+{
+    return last_text && len == last_len && !memcmp( text, last_text, len * sizeof(WCHAR) );
+}
+
+static void set_last_text( WCHAR *text, UINT len )
+{
+    free( last_text );
+    last_text = text;
+    last_len = len;
+}
+
+/* take the Android clipboard text into the Wine clipboard */
+static void grab_android_clipboard(void)
+{
+    struct set_clipboard_params params = { 0 };
+    WCHAR *text;
+    UINT len;
+
+    int ret;
+
+    if ((ret = ioctl_get_clipboard( &text, &len )))
+    {
+        WARN( "could not read the Android clipboard: %d\n", ret );
+        return;
+    }
+    if (!len || is_last_text( text, len ))
+    {
+        free( text );
+        return;
+    }
+
+    TRACE( "Android text %s\n", debugstr_wn( text, min( len, 64 )));
+
+    if (!NtUserOpenClipboard( clipboard_hwnd, 0 ))
+    {
+        free( text );
+        return;
+    }
+    NtUserEmptyClipboard();
+    is_clipboard_owner = TRUE;
+    params.data = text;
+    params.size = (len + 1) * sizeof(WCHAR);
+    NtUserSetClipboardData( CF_UNICODETEXT, 0, &params );
+    NtUserCloseClipboard();
+    set_last_text( text, len );
+}
+
+/* send the text a Windows program put in the clipboard to Android */
+static void export_wine_clipboard(void)
+{
+    struct get_clipboard_params params = { .data_only = TRUE, .size = 4096 };
+    WCHAR *text = NULL;
+    UINT len;
+
+    if (!NtUserOpenClipboard( clipboard_hwnd, 0 )) return;
+    for (;;)
+    {
+        if (!(params.data = malloc( params.size ))) break;
+        if (NtUserGetClipboardData( CF_UNICODETEXT, &params ))
+        {
+            text = params.data;
+            break;
+        }
+        free( params.data );
+        if (!params.data_size) break;
+        params.size = params.data_size;
+        params.data_size = 0;
+    }
+    NtUserCloseClipboard();
+    if (!text) return;  /* no text */
+
+    for (len = 0; len < params.size / sizeof(WCHAR) && text[len]; len++);
+    if (is_last_text( text, len ))
+    {
+        free( text );
+        return;
+    }
+
+    TRACE( "Windows text %s\n", debugstr_wn( text, min( len, 64 )));
+    ioctl_set_clipboard( text, len );
+    set_last_text( text, len );
+}
+
+/* called by the desktop thread when Java reports a clipboard change */
+void android_clipboard_changed(void)
+{
+    if (clipboard_hwnd) NtUserPostMessage( clipboard_hwnd, WM_USER, 0, 0 );
+}
+
+/**********************************************************************
+ *           ANDROID_ClipboardWindowProc
+ */
+LRESULT ANDROID_ClipboardWindowProc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp )
+{
+    switch (msg)
+    {
+    case WM_NCCREATE:
+        clipboard_hwnd = hwnd;
+        NtUserAddClipboardFormatListener( hwnd );
+        NtUserPostMessage( hwnd, WM_USER, 0, 0 );  /* the window may already have focus */
+        return TRUE;
+    case WM_CLIPBOARDUPDATE:
+        if (is_clipboard_owner) break;  /* ignore our own changes */
+        export_wine_clipboard();
+        break;
+    case WM_DESTROYCLIPBOARD:
+        is_clipboard_owner = FALSE;
+        break;
+    case WM_USER:
+        grab_android_clipboard();
+        break;
+    }
+    return NtUserMessageCall( hwnd, msg, wp, lp, NULL, NtUserDefWindowProc, FALSE );
+}
