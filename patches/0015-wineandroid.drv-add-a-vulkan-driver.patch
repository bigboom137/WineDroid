+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <dlfcn.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "android.h"
+
+#include "wine/vulkan.h"
+#include "wine/vulkan_driver.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(vulkan);
+
+/* Wine's generated Vulkan headers leave out the Android platform */
+#define VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR 1000008000
+
+typedef struct VkAndroidSurfaceCreateInfoKHR
+{
+    VkStructureType sType;
+    const void *pNext;
+    VkAndroidSurfaceCreateFlagsKHR flags;
+    struct ANativeWindow *window;
+} VkAndroidSurfaceCreateInfoKHR;
+
+typedef VkResult (VKAPI_PTR *PFN_vkCreateAndroidSurfaceKHR)( VkInstance, const VkAndroidSurfaceCreateInfoKHR *,
+                                                             const VkAllocationCallbacks *, VkSurfaceKHR * );
+
+static PFN_vkGetInstanceProcAddr p_vkGetInstanceProcAddr;
+static const struct client_surface_funcs android_vulkan_surface_funcs;
+
+struct android_vulkan_surface
+{
+    struct client_surface client;
+    ANativeWindow *window;
+};
+
+static struct android_vulkan_surface *impl_from_client_surface( struct client_surface *client )
+{
+    return CONTAINING_RECORD( client, struct android_vulkan_surface, client );
+}
+
+static VkResult android_vulkan_surface_create( HWND hwnd, const struct vulkan_instance *instance, VkSurfaceKHR *handle,
+                                               struct client_surface **client )
+{
+    VkAndroidSurfaceCreateInfoKHR info = { .sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    PFN_vkCreateAndroidSurfaceKHR p_vkCreateAndroidSurfaceKHR;
+    struct android_vulkan_surface *surface;
+    VkResult res;
+
+    TRACE( "%p %p %p %p\n", hwnd, instance, handle, client );
+
+    p_vkCreateAndroidSurfaceKHR = (PFN_vkCreateAndroidSurfaceKHR)p_vkGetInstanceProcAddr( instance->host.instance,
+                                                                                          "vkCreateAndroidSurfaceKHR" );
+    if (!p_vkCreateAndroidSurfaceKHR)
+    {
+        ERR( "vkCreateAndroidSurfaceKHR is not available\n" );
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+    }
+
+    if (!(surface = client_surface_create( sizeof(*surface), &android_vulkan_surface_funcs, hwnd )))
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    if (!(surface->window = get_client_window( hwnd )))
+    {
+        client_surface_release( &surface->client );
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+
+    /* Java creates the client surface asynchronously; until then the window answers -EAGAIN,
+     * which makes libvulkan's connect fail with VK_ERROR_NATIVE_WINDOW_IN_USE_KHR */
+    for (int i = 0, value; i < 200; i++)
+    {
+        if (surface->window->query( surface->window, NATIVE_WINDOW_DEFAULT_WIDTH, &value ) != -EAGAIN) break;
+        usleep( 10000 );
+    }
+
+    info.window = surface->window;
+    if ((res = p_vkCreateAndroidSurfaceKHR( instance->host.instance, &info, NULL /* allocator */, handle )))
+    {
+        ERR( "Failed to create Android surface, res %d\n", res );
+        client_surface_release( &surface->client );
+        return res;
+    }
+
+    *client = &surface->client;
+    TRACE( "Created surface 0x%s, client %s, window %p\n", wine_dbgstr_longlong( *handle ),
+           debugstr_client_surface( *client ), surface->window );
+    return VK_SUCCESS;
+}
+
+static VkBool32 android_get_physical_device_presentation_support( struct vulkan_physical_device *physical_device, uint32_t index )
+{
+    /* every queue family can present on Android */
+    return VK_TRUE;
+}
+
+static void android_map_instance_extensions( struct vulkan_instance_extensions *extensions )
+{
+    /* Android's loader always has VK_KHR_android_surface, which win32u enables in place of
+     * VK_KHR_win32_surface since its generated tables don't know about it */
+    if (extensions->has_VK_KHR_surface) extensions->has_VK_KHR_win32_surface = 1;
+}
+
+static void android_map_device_extensions( struct vulkan_device_extensions *extensions )
+{
+    if (extensions->has_VK_KHR_external_memory_win32) extensions->has_VK_KHR_external_memory_fd = 1;
+    if (extensions->has_VK_KHR_external_memory_fd) extensions->has_VK_KHR_external_memory_win32 = 1;
+    if (extensions->has_VK_KHR_external_semaphore_win32) extensions->has_VK_KHR_external_semaphore_fd = 1;
+    if (extensions->has_VK_KHR_external_semaphore_fd) extensions->has_VK_KHR_external_semaphore_win32 = 1;
+    if (extensions->has_VK_KHR_external_fence_win32) extensions->has_VK_KHR_external_fence_fd = 1;
+    if (extensions->has_VK_KHR_external_fence_fd) extensions->has_VK_KHR_external_fence_win32 = 1;
+}
+
+static void android_vulkan_surface_destroy( struct client_surface *client )
+{
+    struct android_vulkan_surface *surface = impl_from_client_surface( client );
+
+    TRACE( "%s\n", debugstr_client_surface( client ) );
+    if (surface->window) release_ioctl_window( surface->window );
+}
+
+static void android_vulkan_surface_detach( struct client_surface *client )
+{
+}
+
+static void android_vulkan_surface_update( struct client_surface *client )
+{
+}
+
+static void android_vulkan_surface_present( struct client_surface *client, HDC hdc )
+{
+}
+
+static const struct client_surface_funcs android_vulkan_surface_funcs =
+{
+    .destroy = android_vulkan_surface_destroy,
+    .detach = android_vulkan_surface_detach,
+    .update = android_vulkan_surface_update,
+    .present = android_vulkan_surface_present,
+};
+
+static const struct vulkan_driver_funcs android_vulkan_driver_funcs =
+{
+    .p_vulkan_surface_create = android_vulkan_surface_create,
+    .p_get_physical_device_presentation_support = android_get_physical_device_presentation_support,
+    .p_map_instance_extensions = android_map_instance_extensions,
+    .p_map_device_extensions = android_map_device_extensions,
+};
+
+/**********************************************************************
+ *           ANDROID_VulkanInit
+ */
+UINT ANDROID_VulkanInit( UINT version, void *vulkan_handle, const struct vulkan_driver_funcs **driver_funcs )
+{
+    if (version != WINE_VULKAN_DRIVER_VERSION)
+    {
+        ERR( "version mismatch, win32u wants %u but driver has %u\n", version, WINE_VULKAN_DRIVER_VERSION );
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    if (!(p_vkGetInstanceProcAddr = dlsym( vulkan_handle, "vkGetInstanceProcAddr" )))
+    {
+        ERR( "Failed to find vkGetInstanceProcAddr\n" );
+        return STATUS_NOT_IMPLEMENTED;
+    }
+
+    *driver_funcs = &android_vulkan_driver_funcs;
+    return STATUS_SUCCESS;
+}
