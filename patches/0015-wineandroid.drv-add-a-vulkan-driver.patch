 static int perform( ANativeWindow *window, int operation, ... )
@@ -1460,6 +1482,63 @@
         perf.args[0] = va_arg( args, int );
         TRACE( "hwnd %p %s arg %d\n", win->hwnd, names[operation], perf.args[0] );
         break;
+    /* used by the Vulkan swapchain */
+    case NATIVE_WINDOW_SET_BUFFERS_DATASPACE:
+    case NATIVE_WINDOW_SET_SHARED_BUFFER_MODE:
+    case NATIVE_WINDOW_SET_AUTO_REFRESH:
+    case NATIVE_WINDOW_SET_AUTO_PREROTATION:
+    case NATIVE_WINDOW_SET_PRESENT_MODE:
+        perf.args[0] = va_arg( args, int );
+        TRACE( "hwnd %p op %d arg %d\n", win->hwnd, operation, perf.args[0] );
+        break;
+    case NATIVE_WINDOW_API_CONNECT_WITH_LISTENER:
+    {
+        /* api, listener, two flags; libvulkan passes no listener, so it's a plain connect */
+        perf.args[0] = va_arg( args, int );
+        if (va_arg( args, void * )) FIXME( "hwnd %p connect listener not supported\n", win->hwnd );
+        perf.operation = NATIVE_WINDOW_API_CONNECT;
+        TRACE( "hwnd %p API_CONNECT_WITH_LISTENER arg %d\n", win->hwnd, perf.args[0] );
+        break;
+    }
+    case NATIVE_WINDOW_SET_USAGE64:
+    {
+        uint64_t usage = va_arg( args, uint64_t );
+        perf.args[0] = usage;
+        perf.args[1] = usage >> 32;
+        TRACE( "hwnd %p SET_USAGE64 %#llx\n", win->hwnd, (unsigned long long)usage );
+        break;
+    }
+    case NATIVE_WINDOW_GET_CONSUMER_USAGE64:
+        /* what SurfaceFlinger asks for */
+        *va_arg( args, uint64_t * ) = GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_HW_COMPOSER;
+        va_end( args );
+        return 0;
+    case NATIVE_WINDOW_GET_REFRESH_CYCLE_DURATION:
+        *va_arg( args, int64_t * ) = 16666667;  /* 60Hz */
+        va_end( args );
+        return 0;
+    case NATIVE_WINDOW_GET_NEXT_FRAME_ID:
+        *va_arg( args, uint64_t * ) = ++win->frame_id;
+        va_end( args );
+        return 0;
+    case NATIVE_WINDOW_GET_COMPOSITOR_TIMING:
+    case NATIVE_WINDOW_GET_FRAME_TIMESTAMPS:
+    case NATIVE_WINDOW_GET_LAST_ACQUIRED:
+        va_end( args );
+        return -ENOSYS;
+    case NATIVE_WINDOW_ENABLE_FRAME_TIMESTAMPS:
+    case NATIVE_WINDOW_SET_DEQUEUE_TIMEOUT:
+    case NATIVE_WINDOW_SET_SURFACE_DAMAGE:
+    case NATIVE_WINDOW_SET_BUFFERS_SMPTE2086_METADATA:
+    case NATIVE_WINDOW_SET_BUFFERS_CTA861_3_METADATA:
+    case NATIVE_WINDOW_SET_BUFFERS_HDR10_PLUS_METADATA:
+    case NATIVE_WINDOW_SET_FRAME_RATE:
+    case NATIVE_WINDOW_SET_ON_ACQUIRED_CALLBACK:  /* callbacks can't cross processes */
+    case NATIVE_WINDOW_SET_ON_DROPPED_CALLBACK:
+        /* hints that don't need to reach the real window */
+        TRACE( "hwnd %p ignoring op %d\n", win->hwnd, operation );
+        va_end( args );
+        return 0;
     case NATIVE_WINDOW_SET_BUFFER_COUNT:
         perf.args[0] = va_arg( args, size_t );
         TRACE( "hwnd %p %s count %d\n", win->hwnd, names[operation], perf.args[0] );
