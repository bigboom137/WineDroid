From: WineDroid
Subject: [PATCH] wineandroid.drv: Raise windows when they become the foreground window.

Wine doesn't change the Z order when a window is activated; with X11
the window manager raises it. The Android driver had no
ActivateWindow, so SetForegroundWindow from another process (taskbar
buttons, explorer's Alt+` switcher) moved the focus to a window that
stayed behind the others.

Bring a top-level window to the top when it becomes the foreground
window, unless only topmost, hidden or its own owned windows are above
it.

--- a/dlls/wineandroid.drv/android.h
+++ b/dlls/wineandroid.drv/android.h
@@ -100,6 +100,7 @@
 extern BOOL ANDROID_ProcessEvents( DWORD mask );
 extern LRESULT ANDROID_DesktopWindowProc( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp );
 extern void ANDROID_SetParent( HWND hwnd, HWND parent, HWND old_parent );
+extern void ANDROID_ActivateWindow( HWND hwnd, HWND previous );
 extern void ANDROID_SetCapture( HWND hwnd, UINT flags );
 extern UINT ANDROID_ShowWindow( HWND hwnd, INT cmd, RECT *rect, UINT swp );
 extern LRESULT ANDROID_WindowMessage( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp );
--- a/dlls/wineandroid.drv/init.c
+++ b/dlls/wineandroid.drv/init.c
@@ -352,6 +352,7 @@
     .pChangeDisplaySettings = ANDROID_ChangeDisplaySettings,
     .pUpdateDisplayDevices = ANDROID_UpdateDisplayDevices,
     .pCreateDesktop = ANDROID_CreateDesktop,
+    .pActivateWindow = ANDROID_ActivateWindow,
     .pCreateWindow = ANDROID_CreateWindow,
     .pDesktopWindowProc = ANDROID_DesktopWindowProc,
     .pDestroyWindow = ANDROID_DestroyWindow,
--- a/dlls/wineandroid.drv/window.c
+++ b/dlls/wineandroid.drv/window.c
@@ -1285,6 +1285,36 @@
 
 
 /*****************************************************************
+ *	     ANDROID_ActivateWindow
+ *
+ * Bring a window that became the foreground window in front of the others, as
+ * Windows does; on X11 the window manager does it. Without this, SetForegroundWindow
+ * (taskbar buttons, explorer's Alt+` switcher) only moved the focus.
+ */
+void ANDROID_ActivateWindow( HWND hwnd, HWND previous )
+{
+    HWND above;
+
+    if (NtUserGetAncestor( hwnd, GA_PARENT ) != NtUserGetDesktopWindow()) return;
+    if (NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOPMOST) return;
+
+    /* nothing to do if only topmost, hidden or its own windows are above it */
+    for (above = NtUserGetWindowRelative( hwnd, GW_HWNDPREV ); above;
+         above = NtUserGetWindowRelative( above, GW_HWNDPREV ))
+    {
+        if (!(NtUserGetWindowLongW( above, GWL_STYLE ) & WS_VISIBLE)) continue;
+        if (NtUserGetWindowLongW( above, GWL_EXSTYLE ) & WS_EX_TOPMOST) continue;
+        if (NtUserGetWindowRelative( above, GW_OWNER ) == hwnd) continue;
+        break;
+    }
+    if (!above) return;
+
+    TRACE( "raising %p above %p\n", hwnd, above );
+    NtUserSetWindowPos( hwnd, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE );
+}
+
+
+/*****************************************************************
  *	     ANDROID_SetParent
  */
 void ANDROID_SetParent( HWND hwnd, HWND parent, HWND old_parent )
