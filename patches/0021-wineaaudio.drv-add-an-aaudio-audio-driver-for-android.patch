+
+    switch (params->msg)
+    {
+    case DRVM_INIT:
+    case DRVM_EXIT:
+    case DRVM_ENABLE:
+    case DRVM_DISABLE:
+    case AUXDM_GETNUMDEVS:
+        *params->err = 0;
+        break;
+    default:
+        *params->err = MMSYSERR_BADDEVICEID;
+        break;
+    }
+    return STATUS_SUCCESS;
+}
