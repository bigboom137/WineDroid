+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include <aaudio/AAudio.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "winternl.h"
+#include "initguid.h"
+#include "audioclient.h"
+#include "mmddk.h"
+
+#include "wine/debug.h"
+#include "wine/unixlib.h"
+
+#include "../mmdevapi/unixlib.h"
+
+/* Render only: the streams keep the OSS driver's local ring buffer, which the
+ * timer loop feeds to an AAudio stream in blocking-write mode, without blocking. */
+struct aaudio_stream
+{
+    WAVEFORMATEX *fmt;
+    EDataFlow flow;
+    UINT flags;
+    AUDCLNT_SHAREMODE share;
+    HANDLE event;
+
+    AAudioStream *aa;
+    aaudio_format_t aa_format;
+    int64_t silence_end; /* AAudio frame position where the silence written on start ends */
+
+    BOOL playing, mute, please_quit;
+    UINT64 written_frames, last_pos_frames;
+    UINT32 period_frames, bufsize_frames, held_frames, tmp_buffer_frames, in_dev_frames;
+    UINT32 lcl_offs_frames; /* offs into local_buffer where valid data starts */
+    REFERENCE_TIME period;
+
+    BYTE *local_buffer, *tmp_buffer;
+    INT32 getbuf_last; /* <0 when using tmp_buffer */
+
+    pthread_mutex_t lock;
+};
+
+WINE_DEFAULT_DEBUG_CHANNEL(aaudio);
+
+static const REFERENCE_TIME def_period = 100000;
+static const REFERENCE_TIME min_period = 50000;
+
+static const char default_device[] = "default";
+
+static ULONG_PTR zero_bits = 0;
+
+static NTSTATUS aaudio_not_implemented(void *args)
+{
+    return STATUS_SUCCESS;
+}
+
+/* copied from kernelbase */
+static int muldiv( int a, int b, int c )
+{
+    LONGLONG ret;
+
+    if (!c) return -1;
+
+    /* We want to deal with a positive divisor to simplify the logic. */
+    if (c < 0)
+    {
+        a = -a;
+        c = -c;
+    }
+
+    /* If the result is positive, we "add" to round. else, we subtract to round. */
+    if ((a < 0 && b < 0) || (a >= 0 && b >= 0))
+        ret = (((LONGLONG)a * b) + (c / 2)) / c;
+    else
+        ret = (((LONGLONG)a * b) - (c / 2)) / c;
+
+    if (ret > 2147483647 || ret < -2147483647) return -1;
+    return ret;
+}
+
+static void aaudio_lock(struct aaudio_stream *stream)
+{
+    pthread_mutex_lock(&stream->lock);
+}
+
+static void aaudio_unlock(struct aaudio_stream *stream)
+{
+    pthread_mutex_unlock(&stream->lock);
+}
+
+static NTSTATUS aaudio_unlock_result(struct aaudio_stream *stream,
+                                     HRESULT *result, HRESULT value)
+{
+    *result = value;
+    aaudio_unlock(stream);
+    return STATUS_SUCCESS;
+}
+
+static struct aaudio_stream *handle_get_stream(stream_handle h)
+{
+    return (struct aaudio_stream *)(UINT_PTR)h;
+}
+
+static NTSTATUS aaudio_test_connect(void *args)
+{
+    struct test_connect_params *params = args;
+    AAudioStreamBuilder *builder;
+
+    if (AAudio_createStreamBuilder(&builder) != AAUDIO_OK)
+    {
+        params->priority = Priority_Unavailable;
+        return STATUS_SUCCESS;
+    }
+    AAudioStreamBuilder_delete(builder);
+    params->priority = Priority_Preferred;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_process_attach(void *args)
+{
+#ifdef _WIN64
+    if (NtCurrentTeb()->WowTebOffset)
+    {
+        SYSTEM_BASIC_INFORMATION info;
+
+        NtQuerySystemInformation(SystemEmulationBasicInformation, &info, sizeof(info), NULL);
+        zero_bits = (ULONG_PTR)info.HighestUserAddress | 0x7fffffff;
+    }
+#endif
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_main_loop(void *args)
+{
+    struct main_loop_params *params = args;
+    NtSetEvent(params->event, NULL);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_endpoint_ids(void *args)
+{
+    static const WCHAR nameW[] = {'A','n','d','r','o','i','d',' ','a','u','d','i','o',0};
+    struct get_endpoint_ids_params *params = args;
+    unsigned int needed, name_size = sizeof(nameW), device_size = (sizeof(default_device) + 1) & ~1;
+    struct endpoint *endpoint = params->endpoints;
+
+    params->default_idx = 0;
+    if (params->flow != eRender)  /* no capture yet */
+    {
+        params->num = 0;
+        params->result = S_OK;
+        return STATUS_SUCCESS;
+    }
+
+    params->num = 1;
+    needed = sizeof(*endpoint) + name_size + device_size;
+    if (needed > params->size)
+    {
+        params->size = needed;
+        params->result = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+        return STATUS_SUCCESS;
+    }
+    endpoint->name = sizeof(*endpoint);
+    memcpy((char *)params->endpoints + endpoint->name, nameW, name_size);
+    endpoint->device = endpoint->name + name_size;
+    memcpy((char *)params->endpoints + endpoint->device, default_device, sizeof(default_device));
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static UINT get_channel_mask(unsigned int channels)
+{
+    switch(channels){
+    case 0:
+        return 0;
+    case 1:
+        return KSAUDIO_SPEAKER_MONO;
+    case 2:
+        return KSAUDIO_SPEAKER_STEREO;
+    case 3:
+        return KSAUDIO_SPEAKER_STEREO | SPEAKER_LOW_FREQUENCY;
+    case 4:
+        return KSAUDIO_SPEAKER_QUAD;    /* not _SURROUND */
+    case 5:
+        return KSAUDIO_SPEAKER_QUAD | SPEAKER_LOW_FREQUENCY;
+    case 6:
+        return KSAUDIO_SPEAKER_5POINT1; /* not 5POINT1_SURROUND */
+    case 7:
+        return KSAUDIO_SPEAKER_5POINT1 | SPEAKER_BACK_CENTER;
+    case 8:
+        return KSAUDIO_SPEAKER_7POINT1_SURROUND; /* Vista deprecates 7POINT1 */
+    }
+    FIXME("Unknown speaker configuration: %u\n", channels);
+    return 0;
+}
+
+static aaudio_format_t get_aaudio_format(const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_PCM ||
+            (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+             IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM))){
+        switch(fmt->wBitsPerSample){
+        case 16:
+            return AAUDIO_FORMAT_PCM_I16;
+        case 24:
+            return AAUDIO_FORMAT_PCM_I24_PACKED;
+        case 32:
+            return AAUDIO_FORMAT_PCM_I32;
+        }
+        return AAUDIO_FORMAT_INVALID;
+    }
+
+    if(fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ||
+            (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+             IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT)))
+        return fmt->wBitsPerSample == 32 ? AAUDIO_FORMAT_PCM_FLOAT : AAUDIO_FORMAT_INVALID;
+
+    return AAUDIO_FORMAT_INVALID;
+}
+
+static WAVEFORMATEXTENSIBLE *clone_format(const WAVEFORMATEX *fmt)
+{
+    WAVEFORMATEXTENSIBLE *ret;
+    size_t size;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE)
+        size = sizeof(WAVEFORMATEXTENSIBLE);
+    else
+        size = sizeof(WAVEFORMATEX);
+
+    ret = malloc(size);
+    if(!ret)
+        return NULL;
+
+    memcpy(ret, fmt, size);
+
+    ret->Format.cbSize = size - sizeof(WAVEFORMATEX);
+
+    return ret;
+}
+
+/* AAudio converts sample rates and channel counts itself, so only the sample
+ * format limits what is supported */
+static HRESULT check_format(AUDCLNT_SHAREMODE share, const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+    HRESULT ret = S_OK;
+
+    if(get_aaudio_format(fmt) == AAUDIO_FORMAT_INVALID)
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+
+    if(fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+            (fmtex->Format.nAvgBytesPerSec == 0 ||
+             fmtex->Format.nBlockAlign == 0 ||
+             fmtex->Samples.wValidBitsPerSample > fmtex->Format.wBitsPerSample))
+        return E_INVALIDARG;
+
+    if(fmt->nChannels == 0 || fmt->nChannels > 8 || !fmt->nSamplesPerSec)
+        return AUDCLNT_E_UNSUPPORTED_FORMAT;
+
+    if(fmt->nBlockAlign != fmt->nChannels * fmt->wBitsPerSample / 8 ||
+            fmt->nAvgBytesPerSec != fmt->nBlockAlign * fmt->nSamplesPerSec ||
+            (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+             fmtex->Samples.wValidBitsPerSample < fmtex->Format.wBitsPerSample))
+        ret = S_FALSE;
+
+    if(share == AUDCLNT_SHAREMODE_EXCLUSIVE &&
+            fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE){
+        if(fmtex->dwChannelMask == 0 || fmtex->dwChannelMask & SPEAKER_RESERVED)
+            ret = S_FALSE;
+    }
+
+    TRACE("returning: %08x\n", (unsigned)ret);
+    return ret;
+}
+
+static AAudioStream *open_aaudio_stream(const WAVEFORMATEX *fmt, aaudio_format_t format, UINT32 period_frames)
+{
+    AAudioStreamBuilder *builder;
+    AAudioStream *aa = NULL;
+    aaudio_result_t res;
+    int32_t burst, capacity;
+
+    if ((res = AAudio_createStreamBuilder(&builder)) != AAUDIO_OK)
+    {
+        ERR("AAudio_createStreamBuilder failed: %s\n", AAudio_convertResultToText(res));
+        return NULL;
+    }
+    AAudioStreamBuilder_setDirection(builder, AAUDIO_DIRECTION_OUTPUT);
+    AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_SHARED);
+    /* not AAUDIO_PERFORMANCE_MODE_LOW_LATENCY: with a low-latency stream playing,
+     * Android's audio server disabled the Bluetooth (A2DP) output port */
+    AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_NONE);
+    /* not AAUDIO_USAGE_GAME: game audio made Android re-evaluate the Bluetooth
+     * headset's profile (LE Audio) on every stream, until the headset dropped */
+    AAudioStreamBuilder_setUsage(builder, AAUDIO_USAGE_MEDIA);
+    AAudioStreamBuilder_setContentType(builder, AAUDIO_CONTENT_TYPE_MUSIC);
+    AAudioStreamBuilder_setSampleRate(builder, fmt->nSamplesPerSec);
+    AAudioStreamBuilder_setChannelCount(builder, fmt->nChannels);
+    AAudioStreamBuilder_setFormat(builder, format);
+    res = AAudioStreamBuilder_openStream(builder, &aa);
+    AAudioStreamBuilder_delete(builder);
+    if (res != AAUDIO_OK)
+    {
+        ERR("AAudioStreamBuilder_openStream failed: %s\n", AAudio_convertResultToText(res));
+        return NULL;
+    }
+
+    /* room for the three periods the timer loop keeps queued */
+    burst = AAudioStream_getFramesPerBurst(aa);
+    capacity = AAudioStream_getBufferCapacityInFrames(aa);
+    AAudioStream_setBufferSizeInFrames(aa, min(capacity, max(burst * 2, (int32_t)period_frames * 3)));
+
+    TRACE("opened %p rate %d channels %d format %d burst %d capacity %d buffer %d\n", aa,
+          AAudioStream_getSampleRate(aa), AAudioStream_getChannelCount(aa), AAudioStream_getFormat(aa),
+          burst, capacity, AAudioStream_getBufferSizeInFrames(aa));
+    return aa;
+}
+
+static NTSTATUS aaudio_create_stream(void *args)
+{
+    struct create_stream_params *params = args;
+    WAVEFORMATEXTENSIBLE *fmtex;
+    struct aaudio_stream *stream;
+    SIZE_T size;
+
+    params->result = S_OK;
+
+    if (params->flow != eRender || strcmp(params->device, default_device))
+    {
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        return STATUS_SUCCESS;
+    }
+
+    stream = calloc(1, sizeof(*stream));
+    if(!stream){
+        params->result = E_OUTOFMEMORY;
+        return STATUS_SUCCESS;
+    }
+
+    stream->flow = params->flow;
+    pthread_mutex_init(&stream->lock, NULL);
+
+    params->result = check_format(params->share, params->fmt);
+    if(FAILED(params->result))
+        goto exit;
+
+    fmtex = clone_format(params->fmt);
+    if(!fmtex){
+        params->result = E_OUTOFMEMORY;
+        goto exit;
+    }
+    stream->fmt = &fmtex->Format;
+    stream->aa_format = get_aaudio_format(stream->fmt);
+
+    stream->period = params->period;
+    stream->period_frames = muldiv(params->fmt->nSamplesPerSec, params->period, 10000000);
+
+    if(!(stream->aa = open_aaudio_stream(stream->fmt, stream->aa_format, stream->period_frames))){
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        goto exit;
+    }
+
+    stream->bufsize_frames = muldiv(params->duration, params->fmt->nSamplesPerSec, 10000000);
+    if(params->share == AUDCLNT_SHAREMODE_EXCLUSIVE)
+        stream->bufsize_frames -= stream->bufsize_frames % stream->period_frames;
+    size = stream->bufsize_frames * params->fmt->nBlockAlign;
+    if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, zero_bits,
+                               &size, MEM_COMMIT, PAGE_READWRITE)){
+        params->result = E_OUTOFMEMORY;
+        goto exit;
+    }
+
+    stream->share = params->share;
+    stream->flags = params->flags;
+
+exit:
+    if(FAILED(params->result)){
+        if(stream->aa) AAudioStream_close(stream->aa);
+        if(stream->local_buffer){
+            size = 0;
+            NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, &size, MEM_RELEASE);
+        }
+        pthread_mutex_destroy(&stream->lock);
+        free(stream->fmt);
+        free(stream);
+    }else{
+        *params->channel_count = params->fmt->nChannels;
+        *params->stream = (stream_handle)(UINT_PTR)stream;
+    }
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_release_stream(void *args)
+{
+    struct release_stream_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    SIZE_T size;
+
+    if(params->timer_thread){
+        stream->please_quit = TRUE;
+        NtWaitForSingleObject(params->timer_thread, FALSE, NULL);
+        NtClose(params->timer_thread);
+    }
+
+    if(stream->aa) AAudioStream_close(stream->aa);
+    if(stream->local_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->local_buffer, &size, MEM_RELEASE);
+    }
+    if(stream->tmp_buffer){
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+    }
+    free(stream->fmt);
+    pthread_mutex_destroy(&stream->lock);
+    free(stream);
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static void write_start_silence(struct aaudio_stream *stream);
+
+static NTSTATUS aaudio_start(void *args)
+{
+    struct start_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    aaudio_result_t res;
+
+    aaudio_lock(stream);
+
+    if((stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK) && !stream->event)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_EVENTHANDLE_NOT_SET);
+
+    if(stream->playing)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_NOT_STOPPED);
+
+    if(stream->aa) write_start_silence(stream);
+    if(stream->aa && (res = AAudioStream_requestStart(stream->aa)) != AAUDIO_OK)
+        WARN("requestStart failed: %s\n", AAudio_convertResultToText(res));
+
+    stream->playing = TRUE;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_stop(void *args)
+{
+    struct stop_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    if(!stream->playing)
+        return aaudio_unlock_result(stream, &params->result, S_FALSE);
+
+    /* pause, so that what is queued plays when started again */
+    if(stream->aa) AAudioStream_requestPause(stream->aa);
+    stream->playing = FALSE;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_reset(void *args)
+{
+    struct reset_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    if(stream->playing)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_NOT_STOPPED);
+
+    if(stream->getbuf_last)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_BUFFER_OPERATION_PENDING);
+
+    if(stream->aa) AAudioStream_requestFlush(stream->aa);
+
+    stream->written_frames = 0;
+    stream->last_pos_frames = 0;
+    stream->held_frames = 0;
+    stream->lcl_offs_frames = 0;
+    stream->in_dev_frames = 0;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static void silence_buffer(struct aaudio_stream *stream, BYTE *buffer, UINT32 frames)
+{
+    memset(buffer, 0, frames * stream->fmt->nBlockAlign);
+}
+
+/* frames of the program's written to AAudio that it hasn't played yet */
+static UINT32 get_queued_frames(struct aaudio_stream *stream)
+{
+    int64_t written = AAudioStream_getFramesWritten(stream->aa);
+    int64_t start = max(AAudioStream_getFramesRead(stream->aa), stream->silence_end);
+
+    return written > start ? written - start : 0;
+}
+
+/* Android starts playing a stream only once its buffer was filled, which the
+ * program's data alone may never do (Bluetooth has buffers of over 13000 frames),
+ * so start with a buffer full of silence */
+static void write_start_silence(struct aaudio_stream *stream)
+{
+    int64_t written = AAudioStream_getFramesWritten(stream->aa);
+    int32_t frames;
+    void *silence;
+    aaudio_result_t res;
+
+    if (written != AAudioStream_getFramesRead(stream->aa)) return;  /* not drained */
+    frames = AAudioStream_getBufferSizeInFrames(stream->aa);
+    if (frames <= 0 || !(silence = calloc(frames, stream->fmt->nBlockAlign))) return;
+    res = AAudioStream_write(stream->aa, silence, frames, 0);
+    free(silence);
+    if (res > 0) stream->silence_end = written + res;
+    TRACE("wrote %d frames of silence\n", res);
+}
+
+/* the output changed (headphones plugged in, Bluetooth): open a new stream */
+static void reopen_stream(struct aaudio_stream *stream)
+{
+    AAudioStream *aa;
+
+    WARN("output disconnected, reopening\n");
+    if(!(aa = open_aaudio_stream(stream->fmt, stream->aa_format, stream->period_frames))) return;
+    AAudioStream_close(stream->aa);
+    stream->aa = aa;
+    stream->in_dev_frames = 0;
+    stream->silence_end = 0;
+    if(stream->playing){
+        write_start_silence(stream);
+        AAudioStream_requestStart(stream->aa);
+    }
+}
+
+static UINT32 write_frames(struct aaudio_stream *stream, BYTE *buf, UINT32 frames)
+{
+    aaudio_result_t res;
+
+    if(stream->mute)
+        silence_buffer(stream, buf, frames);
+
+    res = AAudioStream_write(stream->aa, buf, frames, 0);
+    if(res == AAUDIO_ERROR_DISCONNECTED){
+        reopen_stream(stream);
+        res = AAudioStream_write(stream->aa, buf, frames, 0);
+    }
+    if(res < 0){
+        WARN("write failed: %s\n", AAudio_convertResultToText(res));
+        return 0;
+    }
+    return res;
+}
+
+static void aaudio_write_data(struct aaudio_stream *stream)
+{
+    UINT32 written_frames, in_dev_frames, write_limit, max_period, write_offs_frames, new_frames;
+    SIZE_T to_write_frames, advanced;
+
+    max_period = max((UINT32)AAudioStream_getFramesPerBurst(stream->aa), stream->period_frames);
+
+    in_dev_frames = get_queued_frames(stream);
+    TRACE("state %d written %lld read %lld queued %u held %u in_dev %u\n", AAudioStream_getState(stream->aa),
+          (long long)AAudioStream_getFramesWritten(stream->aa), (long long)AAudioStream_getFramesRead(stream->aa),
+          in_dev_frames, stream->held_frames, stream->in_dev_frames);
+    if(in_dev_frames > stream->in_dev_frames)
+        in_dev_frames = stream->in_dev_frames;
+
+    write_limit = 0;
+    while(write_limit + in_dev_frames < max_period * 3)
+        write_limit += max_period;
+    if(write_limit == 0)
+        return;
+
+    /*        vvvvvv - in_dev_frames
+     * [--xxxxxxxxxx]
+     *       [xxxxxxxxxx--]
+     *        ^^^^^^^^^^ - held_frames
+     *        ^ - lcl_offs_frames
+     */
+    advanced = stream->in_dev_frames - in_dev_frames;
+    if(advanced > stream->held_frames)
+        advanced = stream->held_frames;
+    stream->lcl_offs_frames += advanced;
+    stream->lcl_offs_frames %= stream->bufsize_frames;
+    stream->held_frames -= advanced;
+    stream->in_dev_frames = in_dev_frames;
+
+    if(stream->held_frames == stream->in_dev_frames)
+        return;
+
+    write_offs_frames = (stream->lcl_offs_frames + stream->in_dev_frames) % stream->bufsize_frames;
+    new_frames = stream->held_frames - stream->in_dev_frames;
+
+    if(write_offs_frames + new_frames > stream->bufsize_frames)
+        to_write_frames = stream->bufsize_frames - write_offs_frames;
+    else
+        to_write_frames = new_frames;
+    to_write_frames = min(to_write_frames, write_limit);
+
+    written_frames = write_frames(stream, stream->local_buffer + write_offs_frames * stream->fmt->nBlockAlign,
+                                  to_write_frames);
+    stream->in_dev_frames += written_frames;
+    if(written_frames < to_write_frames)
+        return;  /* AAudio buffer full */
+
+    if(new_frames > written_frames && written_frames < write_limit){
+        /* wrapped and have some data back at the start to write */
+        to_write_frames = min(write_limit - written_frames, new_frames - written_frames);
+        stream->in_dev_frames += write_frames(stream, stream->local_buffer, to_write_frames);
+    }
+}
+
+static NTSTATUS aaudio_timer_loop(void *args)
+{
+    struct timer_loop_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    LARGE_INTEGER delay, now, next;
+    int adjust;
+
+    aaudio_lock(stream);
+
+    delay.QuadPart = -stream->period;
+    NtQueryPerformanceCounter(&now, NULL);
+    next.QuadPart = now.QuadPart + stream->period;
+
+    while(!stream->please_quit){
+        if(stream->playing && stream->held_frames)
+            aaudio_write_data(stream);
+        if(stream->event)
+            NtSetEvent(stream->event, NULL);
+        aaudio_unlock(stream);
+
+        NtDelayExecution(FALSE, &delay);
+
+        aaudio_lock(stream);
+        NtQueryPerformanceCounter(&now, NULL);
+        adjust = next.QuadPart - now.QuadPart;
+        if(adjust > stream->period / 2)
+            adjust = stream->period / 2;
+        else if(adjust < -stream->period / 2)
+            adjust = -stream->period / 2;
+        delay.QuadPart = -(stream->period + adjust);
+        next.QuadPart += stream->period;
+    }
+
+    aaudio_unlock(stream);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_render_buffer(void *args)
+{
+    struct get_render_buffer_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT32 write_pos, frames = params->frames;
+    BYTE **data = params->data;
+    SIZE_T size;
+
+    aaudio_lock(stream);
+
+    if(stream->getbuf_last)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(!frames)
+        return aaudio_unlock_result(stream, &params->result, S_OK);
+
+    if(stream->held_frames + frames > stream->bufsize_frames)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_BUFFER_TOO_LARGE);
+
+    write_pos =
+        (stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames;
+    if(write_pos + frames > stream->bufsize_frames){
+        if(stream->tmp_buffer_frames < frames){
+            if(stream->tmp_buffer){
+                size = 0;
+                NtFreeVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, &size, MEM_RELEASE);
+                stream->tmp_buffer = NULL;
+            }
+            size = frames * stream->fmt->nBlockAlign;
+            if(NtAllocateVirtualMemory(GetCurrentProcess(), (void **)&stream->tmp_buffer, zero_bits,
+                                       &size, MEM_COMMIT, PAGE_READWRITE)){
+                stream->tmp_buffer_frames = 0;
+                return aaudio_unlock_result(stream, &params->result, E_OUTOFMEMORY);
+            }
+            stream->tmp_buffer_frames = frames;
+        }
+        *data = stream->tmp_buffer;
+        stream->getbuf_last = -frames;
+    }else{
+        *data = stream->local_buffer + write_pos * stream->fmt->nBlockAlign;
+        stream->getbuf_last = frames;
+    }
+
+    silence_buffer(stream, *data, frames);
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static void aaudio_wrap_buffer(struct aaudio_stream *stream, BYTE *buffer, UINT32 written_frames)
+{
+    UINT32 write_offs_frames =
+        (stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames;
+    UINT32 write_offs_bytes = write_offs_frames * stream->fmt->nBlockAlign;
+    UINT32 chunk_frames = stream->bufsize_frames - write_offs_frames;
+    UINT32 chunk_bytes = chunk_frames * stream->fmt->nBlockAlign;
+    UINT32 written_bytes = written_frames * stream->fmt->nBlockAlign;
+
+    if(written_bytes <= chunk_bytes){
+        memcpy(stream->local_buffer + write_offs_bytes, buffer, written_bytes);
+    }else{
+        memcpy(stream->local_buffer + write_offs_bytes, buffer, chunk_bytes);
+        memcpy(stream->local_buffer, buffer + chunk_bytes,
+                written_bytes - chunk_bytes);
+    }
+}
+
+static NTSTATUS aaudio_release_render_buffer(void *args)
+{
+    struct release_render_buffer_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT32 written_frames = params->written_frames;
+    UINT flags = params->flags;
+    BYTE *buffer;
+
+    aaudio_lock(stream);
+
+    if(!written_frames){
+        stream->getbuf_last = 0;
+        return aaudio_unlock_result(stream, &params->result, S_OK);
+    }
+
+    if(!stream->getbuf_last)
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_OUT_OF_ORDER);
+
+    if(written_frames > (stream->getbuf_last >= 0 ? stream->getbuf_last : -stream->getbuf_last))
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_INVALID_SIZE);
+
+    if(stream->getbuf_last >= 0)
+        buffer = stream->local_buffer + stream->fmt->nBlockAlign *
+          ((stream->lcl_offs_frames + stream->held_frames) % stream->bufsize_frames);
+    else
+        buffer = stream->tmp_buffer;
+
+    if(flags & AUDCLNT_BUFFERFLAGS_SILENT)
+        silence_buffer(stream, buffer, written_frames);
+
+    if(stream->getbuf_last < 0)
+        aaudio_wrap_buffer(stream, buffer, written_frames);
+
+    stream->held_frames += written_frames;
+    stream->written_frames += written_frames;
+    stream->getbuf_last = 0;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
