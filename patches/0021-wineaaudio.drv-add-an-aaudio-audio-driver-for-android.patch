+    aaudio_lock(stream);
+
+    *params->padding = stream->held_frames;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_next_packet_size(void *args)
+{
+    struct get_next_packet_size_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT32 *frames = params->frames;
+
+    aaudio_lock(stream);
+
+    *frames = stream->held_frames < stream->period_frames ? 0 : stream->period_frames;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_frequency(void *args)
+{
+    struct get_frequency_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT64 *freq = params->freq;
+
+    aaudio_lock(stream);
+
+    if(stream->share == AUDCLNT_SHAREMODE_SHARED)
+        *freq = (UINT64)stream->fmt->nSamplesPerSec * stream->fmt->nBlockAlign;
+    else
+        *freq = stream->fmt->nSamplesPerSec;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_position(void *args)
+{
+    struct get_position_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT64 *pos = params->pos, *qpctime = params->qpctime;
+
+    if (params->device) {
+        FIXME("Device position reporting not implemented\n");
+        params->result = E_NOTIMPL;
+        return STATUS_SUCCESS;
+    }
+
+    aaudio_lock(stream);
+
+    *pos = stream->written_frames - stream->held_frames;
+    if(*pos < stream->last_pos_frames)
+        *pos = stream->last_pos_frames;
+    stream->last_pos_frames = *pos;
+
+    TRACE("returning: %s\n", wine_dbgstr_longlong(*pos));
+    if(stream->share == AUDCLNT_SHAREMODE_SHARED)
+        *pos *= stream->fmt->nBlockAlign;
+
+    if(qpctime){
+        LARGE_INTEGER stamp, freq;
+        NtQueryPerformanceCounter(&stamp, &freq);
+        *qpctime = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+    }
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_set_volumes(void *args)
+{
+    struct set_volumes_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT16 i;
+
+    if (params->master_volume) {
+        for (i = 0; i < stream->fmt->nChannels; ++i) {
+            if (params->master_volume * params->volumes[i] * params->session_volumes[i] != 1.0f) {
+                FIXME("Volume control is not implemented\n");
+                break;
+            }
+        }
+    }
+
+    aaudio_lock(stream);
+    stream->mute = !params->master_volume;
+    aaudio_unlock(stream);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_set_event_handle(void *args)
+{
+    struct set_event_handle_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    if(!(stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK))
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_EVENTHANDLE_NOT_EXPECTED);
+
+    if (stream->event){
+        FIXME("called twice\n");
+        return aaudio_unlock_result(stream, &params->result, HRESULT_FROM_WIN32(ERROR_INVALID_NAME));
+    }
+
+    stream->event = params->event;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_is_started(void *args)
+{
+    struct is_started_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    return aaudio_unlock_result(stream, &params->result, stream->playing ? S_OK : S_FALSE);
+}
