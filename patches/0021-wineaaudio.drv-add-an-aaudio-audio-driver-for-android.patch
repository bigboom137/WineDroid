+static NTSTATUS aaudio_get_buffer_size(void *args)
+{
+    struct get_buffer_size_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    *params->frames = stream->bufsize_frames;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_latency(void *args)
+{
+    struct get_latency_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    /* pretend we process audio in Period chunks, so max latency includes
+     * the period time.  Some native machines add .6666ms in shared mode. */
+    *params->latency = stream->period + 6666;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_current_padding(void *args)
+{
+    struct get_current_padding_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
