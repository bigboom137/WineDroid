Subject: [PATCH] server: Do not probe futex_waitv on Android.

Android's seccomp filter kills the process on futex_waitv instead of
returning ENOSYS, so the fsync probe crashed wineserver at startup.
---
diff --git a/server/fsync.c b/server/fsync.c
--- a/server/fsync.c
+++ b/server/fsync.c
@@ -62,7 +62,7 @@ int do_fsync_cached = -1;
 
 int fsync_check_support(void)
 {
-#ifdef __linux__
+#if defined(__linux__) && !defined(__ANDROID__)  /* Android's seccomp filter kills callers of futex_waitv */
     syscall( __NR_futex_waitv, 0, 0, 0, 0, 0 );
     return getenv( "WINEFSYNC" ) && atoi(getenv( "WINEFSYNC" )) && errno != ENOSYS && errno != EPERM;
 #else
