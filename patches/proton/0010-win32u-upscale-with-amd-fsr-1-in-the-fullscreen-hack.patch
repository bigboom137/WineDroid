+static uint32_t float_bits( float f )
+{
+    union { float f; uint32_t u; } v = {.f = f};
+    return v.u;
+}
+
+static void image_barrier( VkImageMemoryBarrier *barrier, VkImage image, VkImageLayout old_layout, VkImageLayout new_layout,
+                           VkAccessFlags src_access, VkAccessFlags dst_access )
+{
+    memset( barrier, 0, sizeof(*barrier) );
+    barrier->sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    barrier->oldLayout = old_layout;
+    barrier->newLayout = new_layout;
+    barrier->srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier->dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier->image = image;
+    barrier->subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    barrier->subresourceRange.levelCount = 1;
+    barrier->subresourceRange.layerCount = 1;
+    barrier->srcAccessMask = src_access;
+    barrier->dstAccessMask = dst_access;
+}
+
+/* EASU upscales the user image into fsr_image, RCAS sharpens fsr_image into the swapchain image;
+ * constants as computed by FsrEasuCon and FsrRcasCon in ffx_fsr1.h */
+static VkResult record_fsr_cmd( struct vulkan_device *device, struct swapchain *swapchain, struct fs_hack_image *hack )
+{
+    VkCommandBufferBeginInfo beginInfo = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    float in_w = swapchain->extents.width, in_h = swapchain->extents.height;
+    float out_w = swapchain->host_extents.width, out_h = swapchain->host_extents.height;
+    uint32_t groups_x = (swapchain->host_extents.width + 15) / 16, groups_y = (swapchain->host_extents.height + 15) / 16;
+    VkImageMemoryBarrier barriers[3];
+    uint32_t easu[16], rcas[4] = {0};
+    float sharpness;
+    VkResult res;
+
+    easu[0] = float_bits( in_w / out_w );
+    easu[1] = float_bits( in_h / out_h );
+    easu[2] = float_bits( 0.5f * in_w / out_w - 0.5f );
+    easu[3] = float_bits( 0.5f * in_h / out_h - 0.5f );
+    easu[4] = float_bits( 1.0f / in_w );
+    easu[5] = float_bits( 1.0f / in_h );
+    easu[6] = float_bits( 1.0f / in_w );
+    easu[7] = float_bits( -1.0f / in_h );
+    easu[8] = float_bits( -1.0f / in_w );
+    easu[9] = float_bits( 2.0f / in_h );
+    easu[10] = float_bits( 1.0f / in_w );
+    easu[11] = float_bits( 2.0f / in_h );
+    easu[12] = float_bits( 0.0f );
+    easu[13] = float_bits( 4.0f / in_h );
