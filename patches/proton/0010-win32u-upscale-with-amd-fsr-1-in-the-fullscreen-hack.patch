+/* the image EASU upscales into and RCAS reads, one for all swapchain images: the blits
+ * run one after the other on the present queue and wait for each other with barriers */
+static VkResult create_fsr_image( struct vulkan_device *device, struct swapchain *swapchain )
+{
+    struct vulkan_physical_device *physical_device = device->physical_device;
+    VkImageCreateInfo imageInfo = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    VkImageViewCreateInfo viewInfo = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    VkMemoryAllocateInfo allocInfo = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    VkPhysicalDeviceMemoryProperties memProperties;
+    VkMemoryRequirements memReq;
+    VkResult res;
+    uint32_t i;
+
+    imageInfo.imageType = VK_IMAGE_TYPE_2D;
+    imageInfo.format = VK_FORMAT_R8G8B8A8_UNORM;
+    imageInfo.extent.width = swapchain->host_extents.width;
+    imageInfo.extent.height = swapchain->host_extents.height;
+    imageInfo.extent.depth = 1;
+    imageInfo.mipLevels = 1;
+    imageInfo.arrayLayers = 1;
+    imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+    if ((res = device->p_vkCreateImage( device->host.device, &imageInfo, NULL, &swapchain->fsr_image )))
+    {
+        ERR( "vkCreateImage(fsr): %d\n", res );
+        return res;
+    }
+
+    device->p_vkGetImageMemoryRequirements( device->host.device, swapchain->fsr_image, &memReq );
+    physical_device->instance->p_vkGetPhysicalDeviceMemoryProperties( physical_device->host.physical_device, &memProperties );
+    for (i = 0; i < memProperties.memoryTypeCount; i++)
+        if ((memReq.memoryTypeBits & (1 << i)) &&
+            (memProperties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) break;
+    if (i == memProperties.memoryTypeCount)
+    {
+        ERR( "unable to find suitable memory type for the fsr image\n" );
+        return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    }
+
+    allocInfo.allocationSize = memReq.size;
+    allocInfo.memoryTypeIndex = i;
+    if ((res = device->p_vkAllocateMemory( device->host.device, &allocInfo, NULL, &swapchain->fsr_memory )))
+    {
+        ERR( "vkAllocateMemory(fsr): %d\n", res );
+        return res;
+    }
+    if ((res = device->p_vkBindImageMemory( device->host.device, swapchain->fsr_image, swapchain->fsr_memory, 0 )))
+    {
+        ERR( "vkBindImageMemory(fsr): %d\n", res );
+        return res;
+    }
+
+    viewInfo.image = swapchain->fsr_image;
+    viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.format = VK_FORMAT_R8G8B8A8_UNORM;
+    viewInfo.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    viewInfo.subresourceRange.levelCount = 1;
+    viewInfo.subresourceRange.layerCount = 1;
+    if ((res = device->p_vkCreateImageView( device->host.device, &viewInfo, NULL, &swapchain->fsr_view )))
+        ERR( "vkCreateImageView(fsr): %d\n", res );
+    return res;
+}
+
+static void destroy_fsr_objects( struct vulkan_device *device, struct swapchain *swapchain )
+{
+    device->p_vkDestroyPipeline( device->host.device, swapchain->fsr_easu_pipeline, NULL );
+    device->p_vkDestroyPipeline( device->host.device, swapchain->fsr_rcas_pipeline, NULL );
+    device->p_vkDestroyImageView( device->host.device, swapchain->fsr_view, NULL );
+    device->p_vkDestroyImage( device->host.device, swapchain->fsr_image, NULL );
+    device->p_vkFreeMemory( device->host.device, swapchain->fsr_memory, NULL );
+    swapchain->fsr_easu_pipeline = swapchain->fsr_rcas_pipeline = VK_NULL_HANDLE;
+    swapchain->fsr_view = VK_NULL_HANDLE;
+    swapchain->fsr_image = VK_NULL_HANDLE;
+    swapchain->fsr_memory = VK_NULL_HANDLE;
+}
