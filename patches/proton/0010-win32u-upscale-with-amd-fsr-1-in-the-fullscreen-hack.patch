From: WineDroid
Subject: [PATCH] win32u: Upscale with AMD FSR 1 in the fullscreen hack.

With WINE_FULLSCREEN_FSR set (the launcher's "Upscaling" setting), the
fullscreen hack upscales games rendering below the screen size with
FSR 1: EASU into an intermediate image, then RCAS sharpening into the
swapchain image, instead of the bilinear blit. RCAS sharpness comes
from WINE_FULLSCREEN_FSR_STRENGTH (0 sharpest, default 2), as in
Proton-GE. vulkan_fsr.h holds the SPIR-V of the EASU and RCAS compute
shaders, built with the NDK's glslc from AMD's FidelityFX FSR 1
headers (MIT licensed).

--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -33,6 +33,7 @@
 #define WIN32_NO_STATUS
 #include "win32u_private.h"
 #include "ntuser_private.h"
+#include "vulkan_fsr.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(vulkan);
 
@@ -166,6 +167,23 @@
     return is_int;
 }
 
+/* Return whether the fullscreen hack upscales with AMD FSR 1 (WINE_FULLSCREEN_FSR, like Proton-GE),
+ * and its RCAS sharpness in stops from WINE_FULLSCREEN_FSR_STRENGTH: 0 is the sharpest, default 2 */
+static BOOL fs_hack_is_fsr( float *sharpness )
+{
+    static float strength = 2.0f;
+    static int is_fsr = -1;
+    if (is_fsr < 0)
+    {
+        const char *e = getenv( "WINE_FULLSCREEN_FSR" );
+        is_fsr = e && strcmp( e, "0" ) && !fs_hack_is_integer();
+        if ((e = getenv( "WINE_FULLSCREEN_FSR_STRENGTH" ))) strength = min( max( atof( e ), 0.0 ), 5.0 );
+        TRACE( "is_fsr: %s, strength %.2f\n", is_fsr ? "TRUE" : "FALSE", strength );
+    }
+    if (sharpness) *sharpness = strength;
+    return is_fsr;
+}
